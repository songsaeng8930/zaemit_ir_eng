    <div class="cover-hero">
      <p class="t-over m-rise"><span class="ov-zaemit">Zaemit</span><span class="ov-x">×</span><span class="ov-weven">WEVEN</span></p>
      <h1 class="m-rise" style="--d:.3s">모든 답에 <span class="grad-text">증빙</span>이 있습니다!</h1>
      <p class="csub m-rise" style="--d:.45s">스톡옵션 부여 내역, 특허와 논문, 상용 중인 MCP 서비스까지 실사 자료로 제출하겠습니다.</p>
      <p class="cover-contact m-rise" style="--d:.6s">CEO 김정환 · 010.8447.4567 · kjh@weven.kr</p>
    </div>
  </div>
</div>

<!-- ===== 10 부록 - 바이브코딩 레벨 5 ===== -->
<div class="slide" data-appendix="" data-title-ko="부록 - 바이브코딩 레벨 5">
  <div class="mesh m10"></div>
  <div class="slide-inner">
    <div class="head">
      <div class="section-label">부록 - <span class="num">10</span></div>
      <div class="section-title h3s m-rise">디자인부터 운영까지 전부 자동화한<br>레벨 5는 <span class="za pt-c">Zaemit</span>뿐입니다</div>
      <div class="section-desc m-rise" style="--d:.3s">글로벌 경쟁사들은 아직 '생성'(L3)에 있습니다. Zaemit은 MCP 연동으로 디자인 · 기획 · 개발 · 운영까지 실서비스로 자동화했고, 이 전 구간 자동화가 레벨 5입니다.</div>
    </div>
    <div class="chlist card m-rise" style="--d:.5s">
      <div class="chrow">
        <div class="no">L1</div>
        <div class="nm">코드 어시스트</div>
        <div class="ds">자동완성 · 제안 수준의 보조. 사람이 쓰고 AI가 거듭니다</div>
        <span class="pill soon">범용 코파일럿</span>
      </div>
      <div class="chrow">
        <div class="no">L2</div>
        <div class="nm">부분 생성</div>
        <div class="ds">함수 · 컴포넌트 단위 생성. 조립은 여전히 사람 몫입니다</div>
        <span class="pill soon">대다수 AI 코딩 도구</span>
      </div>
      <div class="chrow">
        <div class="no">L3</div>
        <div class="nm">사이트 단위 생성</div>
        <div class="ds">프롬프트로 사이트 한 벌을 생성. <b>생성이 끝나면 손을 뗍니다</b></div>
        <span class="pill soon">Lovable · Framer · Wix AI</span>
      </div>
      <div class="chrow">
        <div class="no">L4</div>
        <div class="nm">멀티에이전트 분업</div>
        <div class="ds">기획 · 생성 · 검증을 나눠 맡는 오케스트레이션. 특허 출원과 SCI급 논문으로 검증하고 상용 운영 중입니다</div>
        <span class="pill live">위븐 · 상용 운영</span>
      </div>
      <div class="chrow">
        <div class="no">L5</div>
        <div class="nm">전 구간 자율화</div>
        <div class="ds">디자인 · 기획 · 개발에 <b>운영(SEO 등록 · 게시판 · 플러그인)까지 MCP 대화 하나로 자동화</b>. 이걸 실서비스로 제공하는 곳은 Zaemit뿐입니다</div>
        <span class="pill live">Zaemit · 글로벌 유일</span>
      </div>
    </div>
    <div class="ablock proof m-rise" style="--d:.7s">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>증거 · 멀티에이전트 특허 출원 · SCI급 논문(RVE) · 자체 모델 Apollon 상용 · MCP 350개 기능 실서비스</span>
    </div>
    <p class="appendix-note m-rise" style="--d:.85s">※ 단계 분류는 자체 정의 기준이며, 경쟁사 비교 상세표는 실사 자료로 제출합니다</p>
  </div>
</div>

<script>
(function(){
  var slides=document.querySelectorAll('.slide'),total=slides.length,current=0;
  var urlParams=new URLSearchParams(window.location.search);
  var hashParams=new URLSearchParams(window.location.hash.replace('#',''));
  var urlPage=parseInt(urlParams.get('page')||hashParams.get('page'))||0;
  if(urlPage>0&&urlPage<=total)current=urlPage-1;

  var appendixStart=total;
  slides.forEach(function(s,i){if(s.hasAttribute('data-appendix')&&i<appendixStart)appendixStart=i});
  var mainTotal=appendixStart;

  window.irConfig={version:'260815_invest_relations_guide',theme:'zaemit',languages:['ko'],defaultLang:'ko'};

  /* scale-to-fit — zoom 대신 transform:scale (절대배치·SVG 좌표계 보존) */
  function fitSlideContent(s){
    var inner=s.querySelector('.slide-inner');if(!inner)return;
    inner.style.transform='';
    var cs=getComputedStyle(s),pt=parseFloat(cs.paddingTop)||0,pb=parseFloat(cs.paddingBottom)||0,
        pl=parseFloat(cs.paddingLeft)||0,pr=parseFloat(cs.paddingRight)||0;
    var footerH=s.clientWidth*0.07,availH=s.clientHeight-pt-Math.max(pb,footerH),availW=s.clientWidth-pl-pr;
    var natH=inner.scrollHeight,natW=inner.scrollWidth;
    if(natH>availH||natW>availW){var z=Math.min(availH/natH,availW/natW);z=Math.max(0.4,Math.min(1,z));if(z<1)inner.style.transform='scale('+z+')'}
  }

  /* 모션 엔진 — WAAPI (260814_introduce와 동일 규칙) */
  var EASE_OUT='cubic-bezier(0, 0, 0.2, 1)',STEP_MS=80;
  var countRafs=new Map();
  function noMotion(){return document.body.classList.contains('no-motion')}
  function seqOf(sec){
    var seen=new Set(),steps=[];
    sec.querySelectorAll('.m-rise, .m-fade, .m-stagger, .m-count, .m-draw').forEach(function(el){
      var items=el.classList.contains('m-stagger')?Array.prototype.slice.call(el.children):[el];
      items.forEach(function(it){if(!seen.has(it)){seen.add(it);steps.push(it)}});
    });
    return steps;
  }
  function inlineDelay(el){
    var d=el.style&&el.style.getPropertyValue('--d');
    if(d){d=parseFloat(d);if(!isNaN(d))return d*1000}
    return null;
  }
  function riseAnim(el,delay){
    el.animate([{opacity:0,transform:'translateY(0.9375vw)'},{opacity:1,transform:'none'}],
      {duration:700,delay:delay,easing:EASE_OUT,fill:'both'});
  }
  function fadeAnim(el,delay){
    var dur=parseFloat(el.dataset&&el.dataset.mdur)||1100;
    el.animate([{opacity:0},{opacity:1}],{duration:dur,delay:delay,easing:EASE_OUT,fill:'both'});
  }
  function countUp(el,delay,sec){
    if(el.dataset.mcOrig===undefined)el.dataset.mcOrig=el.textContent;
    var orig=el.dataset.mcOrig;
    var m=orig.match(/-?\d[\d,]*(?:\.\d+)?/);
    if(!m)return;
    var raw=m[0],target=parseFloat(raw.replace(/,/g,'')),dec=(raw.split('.')[1]||'').length,grouped=raw.indexOf(',')>=0;
    var pre=orig.slice(0,m.index),post=orig.slice(m.index+raw.length);
    var fmt=function(v){return grouped?v.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec}):v.toFixed(dec)};
    var DUR=1200,start;
    el.textContent=pre+fmt(0)+post;
    var tick=function(now){
      if(start===undefined)start=now+delay;
      var t=(now-start)/DUR;
      if(t>=1){el.textContent=orig;return}
      var eased=t<=0?0:1-Math.pow(1-t,3);
      el.textContent=pre+fmt(target*eased)+post;
      countRafs.get(sec).push(requestAnimationFrame(tick));
    };
    countRafs.get(sec).push(requestAnimationFrame(tick));
  }
  var DRAW_SHAPES='path, line, polyline, circle, ellipse, rect';
  function drawAnim(el,delay){
    var dur=parseFloat(el.dataset&&el.dataset.mdur)||700;
    if(el.style)el.style.opacity='1';
    var shapes=el.matches&&el.matches(DRAW_SHAPES)?[el]:el.querySelectorAll(DRAW_SHAPES);
    shapes.forEach(function(p){
      if(typeof p.getTotalLength!=='function')return;
      var len;try{len=p.getTotalLength()}catch(e){return}
      if(!len)return;
      p.style.strokeDasharray=len;
      p.animate([{strokeDashoffset:len},{strokeDashoffset:0}],
        {duration:dur,delay:delay,easing:'ease-out',fill:'both'});
    });
  }
  function resetMotion(sec){
    (countRafs.get(sec)||[]).forEach(cancelAnimationFrame);
    countRafs.set(sec,[]);
    sec.querySelectorAll('.m-rise, .m-fade, .m-stagger > *, .m-count, .m-draw, .m-draw path, .m-draw line, .m-draw polyline, .m-draw circle, .m-draw ellipse, .m-draw rect').forEach(function(el){
      if(el.getAnimations)el.getAnimations().forEach(function(a){a.cancel()});
      if(el.dataset&&el.dataset.mcOrig!==undefined)el.textContent=el.dataset.mcOrig;
      if(el.style){el.style.strokeDasharray='';el.style.strokeDashoffset=''}
      if(el.classList&&el.classList.contains('m-draw')&&el.style)el.style.opacity='';
    });
  }
  function playMotion(sec){
    if(noMotion())return;
    resetMotion(sec);
    requestAnimationFrame(function(){
      seqOf(sec).forEach(function(el,i){
        var d=inlineDelay(el);
        var delay=(d!==null)?d:i*STEP_MS;
        var inStagger=el.parentElement&&el.parentElement.classList.contains('m-stagger');
        if(el.classList.contains('m-fade'))fadeAnim(el,delay);
        else if(el.classList.contains('m-rise')||inStagger)riseAnim(el,delay);
        if(el.classList.contains('m-count'))countUp(el,delay,sec);
        if(el.classList.contains('m-draw'))drawAnim(el,delay);
      });
    });
  }
  function fitAllSlides(){
    slides.forEach(function(s){
      var h=!s.classList.contains('active');
      if(h){s.style.display='flex';s.style.visibility='hidden'}
      fitSlideContent(s);
      if(h){s.style.display='';s.style.visibility=''}
    });
  }
  var playTimer=null;
  function goTo(idx,src){
    if(idx<0||idx>=total||idx===current)return;
    var os=slides[current];
    os.classList.remove('active');resetMotion(os);current=idx;
    var ns=slides[current];
    ns.style.display='flex';ns.style.visibility='hidden';
    fitSlideContent(ns);
    resetMotion(ns);
    ns.style.display='';ns.style.visibility='';
    ns.classList.add('active');
    if(playTimer)clearTimeout(playTimer);
    playTimer=setTimeout(function(){playMotion(ns)},400);
    if(window.irSlideInfo)window.irSlideInfo.current=current;
    try{parent.postMessage({type:'slideChange',current:current,total:total,mainTotal:mainTotal,appendixStart:appendixStart},'*')}catch(e){}
  }
  window.setLang=function(nl){
    document.body.classList.remove('en','ja','ko');
    if(nl!=='ko')document.body.classList.add(nl);
    requestAnimationFrame(fitAllSlides);
  };
  window.goToSlide=function(idx){goTo(idx,'parent-viewer')};
  window.irSlideInfo={
    slides:Array.from(slides).map(function(s,i){return{index:i,titleKo:s.dataset.titleKo||'슬라이드 '+(i+1),titleEn:s.dataset.titleEn||s.dataset.titleKo||'Slide '+(i+1),titleJa:s.dataset.titleJa||s.dataset.titleKo||'スライド '+(i+1),isAppendix:s.hasAttribute('data-appendix')}}),
    total:total,mainTotal:mainTotal,appendixStart:appendixStart,current:current
  };
  document.addEventListener('keydown',function(e){
    switch(e.key){
      case'ArrowDown':case'ArrowRight':case'PageDown':case' ':e.preventDefault();goTo(current+1,'kb');break;
      case'ArrowUp':case'ArrowLeft':case'PageUp':e.preventDefault();goTo(current-1,'kb');break;
      case'Home':e.preventDefault();goTo(0,'kb');break;case'End':e.preventDefault();goTo(total-1,'kb');break;
    }
  });
  var wAcc=0,wCool=false;
  document.addEventListener('wheel',function(e){e.preventDefault();if(wCool)return;wAcc+=e.deltaY;if(Math.abs(wAcc)>=80){goTo(current+(wAcc>0?1:-1),'wh');wAcc=0;wCool=true;setTimeout(function(){wCool=false},400)}},{passive:false});
  var tX,tY,tT;
  document.addEventListener('touchstart',function(e){var t=e.touches[0];tX=t.clientX;tY=t.clientY;tT=Date.now()},{passive:true});
  document.addEventListener('touchend',function(e){if(Date.now()-tT>300)return;var t=e.changedTouches[0];if(Math.abs(t.clientX-tX)>10||Math.abs(t.clientY-tY)>10)return;var w=window.innerWidth;if(tX<w*.15)goTo(current-1,'t');else if(tX>w*.85)goTo(current+1,'t')},{passive:true});

  if(current>0){slides[0].classList.remove('active');slides[current].classList.add('active')}
  document.fonts.ready.then(function(){fitAllSlides();playMotion(slides[current]);try{parent.postMessage({type:'slideChange',current:current,total:total,mainTotal:mainTotal,appendixStart:appendixStart},'*')}catch(e){}});
  window.addEventListener('resize',function(){requestAnimationFrame(fitAllSlides)});
})();
</script>
</body></html>
