<!DOCTYPE html>
<html lang="ko"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1280">
<title>WEVEN 투자자 질의 대응 — 네 가지 질문</title>
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Fugaz+One&amp;family=Russo+One&amp;display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --z-ink:#111;
  --z-note:#a6afc0;
  --z-accent:#3B82F6;
  --z-accent-light:#74ACFF;
  --z-accent-deep:#2C63D9;
  --z-bg:#FDFDFF;
  --z-pa-lav:185,168,255;
  --z-pa-sky:158,200,255;
  --z-pa-pink:247,185,220;
  --z-pa-mint:167,232,216;
  --z-pa-peach:255,211,184;
  --z-card-line:#DCE5F4;
  --z-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 2px 5px rgba(30,58,138,.05),0 1.171875vw 2.421875vw -0.78125vw rgba(59,130,246,.15);
  --z-glow:0 0.9375vw 1.953125vw -0.703125vw rgba(59,130,246,.45);
}
html,body{height:100%;overflow:hidden;background:var(--z-bg)}
body{font-family:'Pretendard Variable','Pretendard',-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo',sans-serif;color:var(--z-ink);font-size:max(18px,1.25vw);-webkit-font-smoothing:antialiased;word-break:keep-all}

/* ── SLIDES ── */
.slide{
  position:fixed;top:0;left:0;right:0;bottom:0;
  display:none;align-items:center;justify-content:center;
  padding:3.125vw 3.515625vw 7vw;opacity:0;
  background:var(--z-bg);overflow:hidden;
}
.slide.active{display:flex;opacity:1;transition:opacity .4s cubic-bezier(0.4,0,0.2,1)}
.slide .slide-inner{
  position:relative;z-index:2;
  max-width:100%;width:100%;overflow:visible;
  display:flex;flex-direction:column;justify-content:center;
  transform-origin:center center;
}

/* ── 파스텔 메쉬 — 슬라이드별 변주 ── */
.mesh{
  position:absolute;inset:-6.25vw;
  z-index:0;pointer-events:none;
  filter:blur(2.734375vw);
  background:var(--mesh);
}
.m01{--mesh:
  radial-gradient(72.27vw 59.38vw at 4% 10%,rgba(var(--z-pa-lav),.53) 0%,rgba(var(--z-pa-lav),0) 68%),
  radial-gradient(55.47vw 48.83vw at 13% 96%,rgba(var(--z-pa-lav),.35) 0%,rgba(var(--z-pa-lav),0) 66%),
  radial-gradient(74.22vw 61.72vw at 96% 24%,rgba(var(--z-pa-sky),.52) 0%,rgba(var(--z-pa-sky),0) 68%),
  radial-gradient(59.38vw 50.78vw at 89% 96%,rgba(var(--z-pa-sky),.40) 0%,rgba(var(--z-pa-sky),0) 68%),
  #FDFDFF}
.m02{--mesh:
  radial-gradient(72.27vw 59.38vw at 4% 8%,rgba(var(--z-pa-mint),.52) 0%,rgba(var(--z-pa-mint),0) 68%),
  radial-gradient(74.22vw 61.72vw at 96% 92%,rgba(var(--z-pa-sky),.53) 0%,rgba(var(--z-pa-sky),0) 68%),
  radial-gradient(57.42vw 48.83vw at 96% 4%,rgba(var(--z-pa-lav),.40) 0%,rgba(var(--z-pa-lav),0) 66%),
  #FDFDFF}
.m03{--mesh:
  radial-gradient(74.22vw 58.59vw at 8% 0%,rgba(var(--z-pa-sky),.45) 0%,rgba(var(--z-pa-sky),0) 66%),
  radial-gradient(58.59vw 48.83vw at 50% 52%,rgba(var(--z-pa-lav),.22) 0%,rgba(var(--z-pa-lav),0) 62%),
  radial-gradient(74.22vw 58.59vw at 94% 100%,rgba(var(--z-pa-peach),.45) 0%,rgba(var(--z-pa-peach),0) 66%),
  #FDFDFF}
.m04{--mesh:
  radial-gradient(60.55vw 55.47vw at 98% -8%,rgba(var(--z-pa-lav),.55) 0%,rgba(var(--z-pa-lav),0) 64%),
  radial-gradient(54.69vw 60.55vw at 106% 50%,rgba(var(--z-pa-mint),.48) 0%,rgba(var(--z-pa-mint),0) 62%),
  radial-gradient(60.55vw 55.47vw at 98% 108%,rgba(var(--z-pa-sky),.52) 0%,rgba(var(--z-pa-sky),0) 64%),
  #FDFDFF}
.m05{--mesh:
  radial-gradient(66.41vw 41.02vw at 10% -12%,rgba(var(--z-pa-peach),.5) 0%,rgba(var(--z-pa-peach),0) 76%),
  radial-gradient(58.59vw 37.11vw at 50% -16%,rgba(var(--z-pa-pink),.42) 0%,rgba(var(--z-pa-pink),0) 74%),
  radial-gradient(66.41vw 42.97vw at 92% -10%,rgba(var(--z-pa-sky),.5) 0%,rgba(var(--z-pa-sky),0) 76%),
  radial-gradient(50.78vw 35.16vw at 50% 118%,rgba(var(--z-pa-sky),.3) 0%,rgba(var(--z-pa-sky),0) 72%),
  #FDFDFF}
.m06{--mesh:
  radial-gradient(58.59vw 54.69vw at 2% -6%,rgba(var(--z-pa-mint),.5) 0%,rgba(var(--z-pa-mint),0) 64%),
  radial-gradient(52.73vw 58.59vw at -6% 52%,rgba(var(--z-pa-sky),.45) 0%,rgba(var(--z-pa-sky),0) 62%),
  radial-gradient(58.59vw 54.69vw at 2% 106%,rgba(var(--z-pa-pink),.48) 0%,rgba(var(--z-pa-pink),0) 64%),
  #FDFDFF}
.m07{--mesh:
  radial-gradient(58.59vw 48.83vw at 0% 0%,rgba(var(--z-pa-sky),.48) 0%,rgba(var(--z-pa-sky),0) 64%),
  radial-gradient(50.78vw 42.97vw at 100% 0%,rgba(var(--z-pa-lav),.38) 0%,rgba(var(--z-pa-lav),0) 62%),
  radial-gradient(50.78vw 42.97vw at 0% 100%,rgba(var(--z-pa-lav),.38) 0%,rgba(var(--z-pa-lav),0) 62%),
  radial-gradient(58.59vw 48.83vw at 100% 100%,rgba(var(--z-pa-pink),.48) 0%,rgba(var(--z-pa-pink),0) 64%),
  #FDFDFF}
.m08{--mesh:
  radial-gradient(76.17vw 60.55vw at 96% 0%,rgba(var(--z-pa-peach),.5) 0%,rgba(var(--z-pa-peach),0) 66%),
  radial-gradient(76.17vw 60.55vw at 2% 100%,rgba(var(--z-pa-lav),.46) 0%,rgba(var(--z-pa-lav),0) 66%),
  #FDFDFF}
.m09{--mesh:
  radial-gradient(64.45vw 52.73vw at 2% 0%,rgba(var(--z-pa-peach),.58) 0%,rgba(var(--z-pa-peach),0) 64%),
  radial-gradient(62.5vw 50.78vw at 100% 4%,rgba(var(--z-pa-pink),.58) 0%,rgba(var(--z-pa-pink),0) 64%),
  radial-gradient(68.36vw 50.78vw at 50% 108%,rgba(var(--z-pa-lav),.54) 0%,rgba(var(--z-pa-lav),0) 66%),
  #FDFDFF}
.m10{--mesh:
  radial-gradient(70.31vw 56.64vw at 0% 2%,rgba(var(--z-pa-sky),.5) 0%,rgba(var(--z-pa-sky),0) 66%),
  radial-gradient(52.73vw 44.92vw at 46% -10%,rgba(var(--z-pa-mint),.35) 0%,rgba(var(--z-pa-mint),0) 62%),
  radial-gradient(70.31vw 56.64vw at 100% 102%,rgba(var(--z-pa-lav),.5) 0%,rgba(var(--z-pa-lav),0) 66%),
  #FDFDFF}

/* ── 모션 (초기 숨김 — 재생은 WAAPI) ── */
.slide .m-rise,.slide .m-fade,.slide .m-draw,.slide .m-stagger>*{opacity:0}
body.no-motion *,body.no-motion *::before,body.no-motion *::after{animation-duration:0.001s !important;animation-delay:0s !important;transition-duration:0.001s !important;transition-delay:0s !important}
body.no-motion .slide .m-rise,body.no-motion .slide .m-fade,body.no-motion .slide .m-draw,body.no-motion .slide .m-stagger>*{opacity:1 !important;transform:none !important}

/* ── 타이포·브랜드 ── */
.za{font-family:'Fugaz One','Pretendard Variable',sans-serif;font-weight:400;font-synthesis:none}
.zw{font-family:'Russo One','Pretendard Variable',sans-serif;font-weight:400;font-synthesis:none}
.pt-c{color:var(--z-accent)}
.grad-text{background:linear-gradient(96deg,var(--z-accent-deep) 0%,var(--z-accent) 48%,var(--z-accent-light) 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
.t-over{font-size:max(18px,1.015625vw);font-weight:600;letter-spacing:0.2734375vw;line-height:1.3;color:var(--z-note)}
.tnum{font-variant-numeric:tabular-nums}

/* ── 섹션 헤더 ── */
.head{position:relative;flex:none;text-align:center}
.section-label{position:absolute;left:0;top:0.43vw;text-align:left;font-size:max(18px,0.9375vw);font-weight:700;line-height:1.18;color:var(--z-ink);letter-spacing:-0.02em;white-space:nowrap;font-variant-numeric:tabular-nums}
.section-title{font-size:3.4375vw;font-weight:800;letter-spacing:-0.03em;line-height:1.18;color:var(--z-ink)}
.section-title.h3s{font-size:3.125vw;line-height:1.22}
.section-desc{margin-top:0.9375vw;font-size:1.5625vw;font-weight:500;letter-spacing:-0.01em;line-height:1.52;color:var(--z-ink)}
.section-desc b,.section-desc strong{font-weight:700}

/* ── 카드 ── */
.card{
  background:linear-gradient(180deg,#FFFFFF 0%,#FEFEFF 46%,#F9FBFE 100%);
  border:1px solid var(--z-card-line);
  border-top-color:#EAF0FA;
  border-radius:1.09375vw;
  box-shadow:var(--z-shadow);
}
.card.pend{background:rgba(255,255,255,.55);border:2px dashed #C9D6EA;box-shadow:none}
.ablock{
  border-radius:1.09375vw;
  background:linear-gradient(120deg,var(--z-accent-deep) 0%,var(--z-accent) 100%);
  box-shadow:var(--z-glow);
  display:flex;align-items:center;justify-content:center;
  color:#fff;
}
.pill{display:inline-block;padding:0.3125vw 0.859375vw;border-radius:999px;font-size:max(18px,0.8203125vw);font-weight:600;letter-spacing:-0.01em;white-space:nowrap}
.pill.live{background:rgba(59,130,246,.09);color:var(--z-accent)}
.pill.soon{background:#FFFFFF;border:1.5px dashed #AEBFD9;color:var(--z-note)}
.appendix-note{flex:none;margin-top:1.25vw;text-align:center;font-size:max(18px,1.015625vw);font-weight:500;letter-spacing:-0.005em;color:var(--z-note)}

/* ── 표지/클로징 ── */
.cover-hero{min-height:44vw;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.cover-hero .t-over{font-size:1.7578125vw;margin-bottom:2.578125vw;letter-spacing:0;display:flex;align-items:center;justify-content:center;color:var(--z-ink)}
.cover-hero .ov-x{margin:0 1.2890625vw;font-family:'Pretendard Variable',sans-serif;font-weight:100;font-size:1.35em;line-height:1;color:#111;opacity:.3;transform:translateY(-0.2vw)}
.cover-hero .ov-zaemit{font-family:'Fugaz One',sans-serif;font-weight:400;color:var(--z-accent)}
.cover-hero .ov-weven{font-family:'Russo One',sans-serif;font-weight:400;font-size:.95em;font-synthesis:none;color:#111}
.cover-hero h1{font-size:4.296875vw;font-weight:800;letter-spacing:-0.03em;line-height:1.15;color:var(--z-ink)}
.cover-hero .csub{font-weight:600;font-size:1.640625vw;margin-top:1.09375vw;letter-spacing:-0.03em;color:var(--z-ink)}
.cover-hero .csub strong{font-weight:700;color:var(--z-accent)}
.cover-contact{margin-top:5vw;text-align:center;font-size:max(18px,1.25vw);font-weight:500;color:var(--z-note)}

/* ── 02 질문 목차 (4단) ── */
.toc-head .t-over{margin-bottom:0.859375vw}
.qgrid{width:100%;margin-top:5vw;height:17.1875vw;display:grid;grid-template-columns:repeat(4,1fr)}
.qcol{display:flex;flex-direction:column;justify-content:space-between;padding:0.234375vw 2.1484375vw;border-left:1px solid #dedee8}
.qcol:first-child{border-left:0;padding-left:0}
.qcol:last-child{padding-right:0}
.qcol .qn{font-size:max(18px,0.9375vw);font-weight:700;letter-spacing:.06em;color:var(--z-accent);font-variant-numeric:tabular-nums}
.qcol .pt{margin-top:0.546875vw;font-size:2.109375vw;font-weight:800;letter-spacing:-0.02em;line-height:1.2;color:var(--z-ink)}
.qcol .ds{margin-top:0.78125vw;font-size:max(18px,1.015625vw);font-weight:500;letter-spacing:-0.01em;line-height:1.45;color:var(--z-ink)}
.qcol .pg{font-size:max(18px,0.9375vw);font-weight:500;letter-spacing:.02em;color:var(--z-note);font-variant-numeric:tabular-nums}

/* ── 03 리더진 ── */
.lgrid{margin-top:2.65625vw;display:grid;grid-template-columns:repeat(4,1fr);gap:1.09375vw}
.lcard{padding:1.71875vw 1.5625vw;display:flex;flex-direction:column}
.lcard .avatar{width:3.90625vw;height:3.90625vw;border-radius:50%;background:rgba(59,130,246,.08);color:var(--z-accent);display:flex;align-items:center;justify-content:center}
.lcard .avatar svg{width:1.953125vw;height:1.953125vw}
.lcard .mrole{margin-top:1.09375vw;font-size:max(18px,0.859375vw);font-weight:600;letter-spacing:-0.01em;color:var(--z-accent)}
.lcard .mname{margin-top:0.234375vw;font-size:1.484375vw;font-weight:800;letter-spacing:-0.02em;line-height:1.25;color:var(--z-ink)}
.lcard ul{margin-top:0.859375vw;list-style:none;display:flex;flex-direction:column;gap:0.3125vw}
.lcard li{font-size:max(18px,0.8984375vw);font-weight:500;letter-spacing:-0.01em;line-height:1.45;color:var(--z-ink)}
.proof{margin-top:1.40625vw;height:4.21875vw;gap:0.78125vw;font-size:max(18px,1.328125vw);font-weight:700;letter-spacing:-0.01em}
.proof svg{width:1.484375vw;height:1.484375vw;flex:none}

/* ── 04 리텐션 3카드 ── */
.rgrid{margin-top:2.65625vw;display:grid;grid-template-columns:repeat(3,1fr);gap:1.09375vw}
.rcard{padding:1.953125vw 1.875vw;display:flex;flex-direction:column}
.rcard .rhead{display:flex;align-items:center;justify-content:space-between}
.rcard .tile{width:3.046875vw;height:3.046875vw;border-radius:0.78125vw;background:rgba(59,130,246,.08);color:var(--z-accent);display:flex;align-items:center;justify-content:center}
.rcard .tile svg{width:1.71875vw;height:1.71875vw}
.rcard h4{margin-top:1.09375vw;font-size:1.71875vw;font-weight:800;letter-spacing:-0.02em;color:var(--z-ink)}
.rcard p{margin-top:0.703125vw;font-size:max(18px,1.0546875vw);font-weight:500;letter-spacing:-0.01em;line-height:1.55;color:var(--z-ink)}
.rcard p b{font-weight:700}
.rcard p .pt-c{font-weight:700}

/* ── 05 로드맵 5단 계단 ── */
.roadmap{position:relative;height:31.25vw;margin-top:2.8125vw;display:grid;grid-template-columns:repeat(5,1fr);gap:1.09375vw;align-items:end}
.lv{position:relative;padding:1.484375vw 1.40625vw 0;display:flex;flex-direction:column}
.lv .wm{position:absolute;right:1.015625vw;bottom:0.390625vw;font-size:7.03125vw;font-weight:800;line-height:1;color:rgba(17,22,38,.05);pointer-events:none}
.lv-1{height:18.359375vw}
.lv-2{height:21.484375vw}
.lv-3{height:24.609375vw}
.lv-4{height:27.734375vw}
.lv-5{height:31.25vw}
.lv .lab{font-size:max(18px,0.9375vw);font-weight:700;letter-spacing:.06em;color:var(--z-note);font-variant-numeric:tabular-nums}
.lv .tit{margin-top:0.703125vw;font-size:1.796875vw;font-weight:800;letter-spacing:-0.02em;line-height:1.25;color:var(--z-ink)}
.lv .desc{margin-top:1.09375vw;padding-top:1.09375vw;border-top:1px solid #E7EDF8;font-size:max(18px,1.0546875vw);font-weight:500;letter-spacing:-0.01em;line-height:1.5;color:var(--z-ink)}
.lv-5{background:linear-gradient(168deg,#3B82F6 0%,#2C63D9 100%);border:1px solid #2C63D9;border-radius:0.859375vw;box-shadow:0 1.328125vw 2.890625vw -0.78125vw rgba(44,99,217,.42)}
.lv-5 .wm{color:rgba(255,255,255,.14)}
.lv-5 .lab{color:rgba(255,255,255,.85)}
.lv-5 .tit{color:#FFFFFF}
.lv-5 .desc{border-top-color:rgba(255,255,255,.24);color:#fff}
.goal{position:absolute;top:-1.2109375vw;left:50%;transform:translateX(-50%);padding:0.5078125vw 1.171875vw;border-radius:999px;background:#FFFFFF;border:1.5px solid #C7DAFB;box-shadow:0 0.46875vw 1.171875vw -0.3125vw rgba(44,99,217,.30);font-size:max(18px,1.015625vw);font-weight:800;letter-spacing:-0.01em;color:var(--z-accent);white-space:nowrap}

/* ── 06·08 좌우 스펙 카드 ── */
.duo{margin-top:2.65625vw;display:grid;grid-template-columns:1fr 1fr;gap:1.40625vw;align-items:stretch}
.spec{padding:1.71875vw 2.109375vw;display:flex;flex-direction:column}
.spec .glabel{flex:none;font-size:max(18px,1.015625vw);font-weight:600;letter-spacing:-0.005em;color:var(--z-note)}
.spec-rows{flex:1;min-height:0;margin-top:0.625vw;display:flex;flex-direction:column}
.srow{flex:1;display:flex;align-items:center;gap:1.25vw;border-top:1px solid #EDF1F8;padding:0.9375vw 0}
.srow:first-child{border-top:0}
.srow .k{flex:none;width:9.375vw;font-size:max(18px,0.9375vw);font-weight:700;letter-spacing:-0.01em;line-height:1.35;color:var(--z-accent)}
.srow .v{font-size:max(18px,1.0546875vw);font-weight:500;letter-spacing:-0.01em;line-height:1.5;color:var(--z-ink)}
.srow .v b{font-weight:700}

/* ── 07 GTM 5채널 ── */
.chlist{margin-top:2.65625vw;padding:0.9375vw 2.34375vw;display:flex;flex-direction:column}
.chrow{display:grid;grid-template-columns:2.34375vw 13.28125vw 1fr auto;align-items:center;gap:1.40625vw;border-top:1px solid #EDF1F8;padding:1.015625vw 0}
.chrow:first-child{border-top:0}
.chrow .no{font-size:1.5625vw;font-weight:800;color:var(--z-accent);font-variant-numeric:tabular-nums}
.chrow .nm{font-size:max(18px,1.2109375vw);font-weight:800;letter-spacing:-0.02em;line-height:1.3;color:var(--z-ink)}
.chrow .ds{font-size:max(18px,1.0546875vw);font-weight:500;letter-spacing:-0.01em;line-height:1.5;color:var(--z-ink)}
.chrow .ds b{font-weight:700}
</style>
</head>
<body>

<!-- ===== 01 표지 ===== -->
<div class="slide active" data-title-ko="표지">
  <div class="mesh m01"></div>
  <div class="slide-inner">
    <div class="cover-hero">
      <p class="t-over m-rise"><span class="ov-zaemit">Zaemit</span><span class="ov-x">×</span><span class="ov-weven">WEVEN</span></p>
      <h1 class="m-rise" style="--d:.3s">질문 주신 네 가지,<br><span class="grad-text">확인 가능한 사실</span>로 답하겠습니다</h1>
      <p class="csub m-rise" style="--d:.45s">인력 · 리텐션 · 기술 로드맵 · GTM, 주식회사 위븐 투자자 질의 대응</p>
      <p class="cover-contact m-rise" style="--d:.6s">CEO 김정환 · 010.8447.4567 · kjh@weven.kr · 2026.08</p>
    </div>
  </div>
</div>

<!-- ===== 02 질문 목차 ===== -->
<div class="slide" data-title-ko="받은 질문 네 가지">
  <div class="mesh m02"></div>
  <div class="slide-inner">
    <div class="head head-left toc-head" style="text-align:left">
      <p class="t-over m-rise">QUESTIONS</p>
      <div class="section-title m-rise" style="--d:.3s">받은 질문 네 가지, 그대로 실었습니다</div>
    </div>
    <div class="qgrid m-stagger">
      <div class="qcol">
        <div class="top">
          <div class="qn">Q1</div>
          <div class="pt">인력 경쟁력</div>
