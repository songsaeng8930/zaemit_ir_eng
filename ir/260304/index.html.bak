<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="WEVEN IR — AI Vibe-Coding Platform">
<meta name="twitter:description" content="AI 기반 웹사이트 자동생성 서비스 Zaemit IR Deck">
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#0066FF;--accent:#00D4AA;--accent2:#7C3AED;
  --dark:#0A0E27;--dark2:#111633;--text:#E2E8F0;--text-muted:#94A3B8;
  --gradient1:linear-gradient(135deg,#0066FF 0%,#7C3AED 50%,#00D4AA 100%);
  --gradient2:linear-gradient(135deg,#00D4AA 0%,#0066FF 100%);
  --gradient3:linear-gradient(135deg,#7C3AED 0%,#EC4899 100%);
}
html,body{height:100%;overflow:hidden;background:var(--dark)}
body{font-family:'Pretendard Variable','Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;color:var(--text);font-size:max(18px,1.25vw)}
body.en{font-family:'Plus Jakarta Sans','Pretendard Variable',-apple-system,BlinkMacSystemFont,sans-serif}
body.ja{font-family:'Noto Sans JP','Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif}

/* ── SLIDES ── */
.slide{
  position:fixed;top:0;left:0;right:0;bottom:0;
  display:none;align-items:center;justify-content:center;
  padding:4.6875vw 7.8125vw 7vw;opacity:0;
  transition:left .35s cubic-bezier(.16,1,.3,1);
}
.slide.active{display:flex;opacity:1;transition:opacity .5s ease}
.slide .slide-inner{
  max-width:100%;width:100%;overflow:hidden;
  opacity:0;transform:translateY(1.5625vw);
  transition:opacity .45s ease .1s,transform .45s ease .1s;
}
.slide.active .slide-inner{opacity:1;transform:translateY(0)}

/* ── ENTRANCE ANIMATIONS ── */
@keyframes aFadeUp{from{opacity:0;transform:translateY(2.1875vw)}to{opacity:1;transform:translateY(0)}}
@keyframes aFadeIn{from{opacity:0}to{opacity:1}}
@keyframes aScaleIn{from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)}}
@keyframes aSlideR{from{opacity:0;transform:translateX(-2.5vw)}to{opacity:1;transform:translateX(0)}}
@keyframes aSlideL{from{opacity:0;transform:translateX(2.5vw)}to{opacity:1;transform:translateX(0)}}
@keyframes aTypeDown{from{opacity:0;transform:translateY(-0.9375vw)}to{opacity:1;transform:translateY(0)}}
@keyframes aLineDraw{from{stroke-dashoffset:var(--dash)}to{stroke-dashoffset:0}}
@keyframes aAreaReveal{from{opacity:0}to{opacity:1}}

/* All animatable children start hidden */
.slide .section-label,
.slide .section-title,
.slide .section-desc,
.slide .hero-left,
.slide .hero-right,
.slide .hero-stats,
.slide .problem-flow,
.slide .solution-content,
.slide .solution-step,
.slide .mkt-table-wrap,
.slide .mkt-chart-area,
.slide .biz-diagram-wrap,
.slide .biz-rev-summary,
.slide .sales-layout,
.slide .team-layout,
.slide .gp-nda-row,
.slide .gp-countries,
.slide .roadmap-container,
.slide .roadmap-year,
.slide .exit-chart-area,
.slide .ask-stats,
.slide .cta-buttons,
.slide .fin-bar-svg,
.slide .svc-phases,
.slide .svc-phase,
.slide .svc-cloud-bar,
.slide .comp-table,
.slide .comp-zaemit-cell,
.slide .market-content,
.slide .mkt-stages,
.slide .mkt-stage,
.slide .mkt-maturity-label,
.slide .mkt-bullets,
.slide .problem-col,
.slide .upcoming-grid,
.slide .upcoming-card,
.slide .kpi-layout,
.slide .kpi-card,
.slide .mkt-fc-stats,
.slide .mkt-fc-body,
.slide .mkt-src-wrap,
.slide .overview-layout,
.slide .ov-main,
.slide .ov-badges,
.slide .ip-grid,
.slide .ip-card,
.slide .ms-strategy,
.slide .ms-phase,
.slide .fin-layout,
.slide .fin-card,
.slide .inv-timeline,
.slide .b2b-grid,
.slide .b2b-card,
.slide .pricing-grid,
.slide .pricing-card{
  opacity:0;
}

/* When slide becomes active, animate children with stagger */
.slide.active .section-label{animation:aFadeUp .5s ease .15s both}
.slide.active .section-title{animation:aFadeUp .55s ease .3s both}
.slide.active .section-desc{animation:aFadeUp .5s ease .45s both}

/* Hero specifics */
.slide.active .hero-left{animation:aSlideR .6s ease .2s both}
.slide.active .hero-right{animation:aSlideL .6s ease .4s both}
.slide.active .hero-stats{animation:aFadeUp .5s ease .7s both}

/* Grids & layouts stagger */
.slide.active .overview-layout{animation:aFadeUp .5s ease .5s both}
.slide.active .problem-flow{animation:aFadeUp .5s ease .55s both}
.slide.active .solution-content{animation:aFadeIn .3s ease .5s both}
.slide.active .solution-step:nth-child(1){animation:aFadeUp .5s ease .55s both}
.slide.active .solution-step:nth-child(2){animation:aFadeUp .5s ease .75s both}
.slide.active .solution-step:nth-child(3){animation:aFadeUp .5s ease .95s both}
.slide.active .mkt-table-wrap{animation:aFadeUp .5s ease .6s both}
.slide.active .mkt-chart-area{animation:aFadeIn .6s ease .7s both}

/* Service phases stagger */
.slide.active .svc-phases{animation:aFadeIn .3s ease .5s both}
.slide.active .svc-phase:nth-child(1){animation:aFadeUp .5s ease .55s both}
.slide.active .svc-phase:nth-child(2){animation:aFadeUp .5s ease .7s both}
.slide.active .svc-phase:nth-child(3){animation:aFadeUp .5s ease .85s both}
.slide.active .svc-cloud-bar{animation:aFadeUp .4s ease 1.1s both}

/* Business model */
.slide.active .biz-diagram-wrap{animation:aScaleIn .6s ease .5s both}
.slide.active .biz-rev-summary{animation:aFadeUp .4s ease 1.0s both}

/* Pricing cards stagger */
.slide.active .pricing-grid{animation:aFadeIn .3s ease .5s both}
.slide.active .pricing-card:nth-child(1){animation:aFadeUp .45s ease .55s both}
.slide.active .pricing-card:nth-child(2){animation:aFadeUp .45s ease .7s both}
.slide.active .pricing-card:nth-child(3){animation:aFadeUp .45s ease .85s both}
.slide.active .pricing-card:nth-child(4){animation:aFadeUp .45s ease 1.0s both}

/* Sales */
.slide.active .sales-layout{animation:aFadeUp .55s ease .5s both}

/* Team */
.slide.active .team-layout{animation:aFadeUp .55s ease .5s both}

/* Global partners */
.slide.active .gp-nda-row{animation:aFadeUp .5s ease .4s both}
.slide.active .gp-countries{animation:aFadeIn .3s ease .9s both}

/* Roadmap */
.slide.active .roadmap-container{animation:aFadeIn .6s ease .4s both}
.slide.active .roadmap-year:nth-child(1){animation:aFadeUp .4s ease .6s both}
.slide.active .roadmap-year:nth-child(2){animation:aFadeUp .4s ease .8s both}
.slide.active .roadmap-year:nth-child(3){animation:aFadeUp .4s ease 1.0s both}
.slide.active .roadmap-year:nth-child(4){animation:aFadeUp .4s ease 1.2s both}

/* Exit strategy */
.slide.active .exit-chart-area{animation:aFadeIn .7s ease .5s both}

/* Competitive */
.slide.active .comp-table{animation:aFadeUp .6s ease .5s both}

/* Market / Vibe Coding */
.slide.active .market-content{animation:aFadeUp .5s ease .5s both}
.slide.active .mkt-bullets{animation:aFadeUp .5s ease .55s both}
.slide.active .mkt-maturity-label{animation:aFadeUp .4s ease .7s both}
.slide.active .mkt-stages{animation:aFadeIn .3s ease .85s both}
.slide.active .mkt-stage:nth-child(1){animation:aFadeUp .4s ease .9s both}
.slide.active .mkt-stage:nth-child(2){animation:aFadeUp .4s ease 1.05s both}
.slide.active .mkt-stage:nth-child(3){animation:aScaleIn .5s ease 1.2s both}
.slide.active .mkt-stage:nth-child(4){animation:aFadeUp .4s ease 1.5s both}
.slide.active .mkt-stage:nth-child(5){animation:aFadeUp .4s ease 1.65s both}
.slide.active .mkt-fc-stats{animation:aFadeUp .5s ease .5s both}
.slide.active .mkt-fc-body{animation:aFadeUp .5s ease .65s both}
.slide.active .mkt-src-wrap{animation:aFadeUp .5s ease .5s both}

/* Problem columns stagger */
.slide.active .problem-col:nth-child(1){animation:aFadeUp .5s ease .5s both}
.slide.active .problem-col:nth-child(2){animation:aFadeUp .5s ease .9s both}
.slide.active .problem-col:nth-child(3){animation:aFadeUp .5s ease 1.3s both}

/* Competitive table Zaemit column */
.slide.active .comp-table tbody tr:nth-child(1) .comp-zaemit-cell{animation:aTypeDown .35s ease .6s both}
.slide.active .comp-table tbody tr:nth-child(2) .comp-zaemit-cell{animation:aTypeDown .35s ease .72s both}
.slide.active .comp-table tbody tr:nth-child(3) .comp-zaemit-cell{animation:aTypeDown .35s ease .84s both}
.slide.active .comp-table tbody tr:nth-child(4) .comp-zaemit-cell{animation:aTypeDown .35s ease .96s both}
.slide.active .comp-table tbody tr:nth-child(5) .comp-zaemit-cell{animation:aTypeDown .35s ease 1.08s both}
.slide.active .comp-table tbody tr:nth-child(6) .comp-zaemit-cell{animation:aTypeDown .35s ease 1.2s both}
.slide.active .comp-table tbody tr:nth-child(7) .comp-zaemit-cell{animation:aTypeDown .35s ease 1.32s both}

/* SVG animations */
.svg-draw{stroke-dasharray:var(--dash);stroke-dashoffset:var(--dash)}
.slide.active .svg-draw{animation:aLineDraw 2s cubic-bezier(.25,.1,.25,1) .6s both}
.svg-area{opacity:0}
.slide.active .svg-area{animation:aAreaReveal .8s ease 1.8s both}
.svg-draw-rev{stroke-dasharray:var(--dash);stroke-dashoffset:var(--dash)}
.svg-draw-sub{stroke-dasharray:var(--dash);stroke-dashoffset:var(--dash)}
.slide.active .svg-draw-rev{animation:aLineDraw 2.2s cubic-bezier(.25,.1,.25,1) .6s both}
.slide.active .svg-draw-sub{animation:aLineDraw 2.2s cubic-bezier(.25,.1,.25,1) .8s both}

/* Upcoming Services */
.slide.active .upcoming-grid{animation:aFadeIn .3s ease .4s both}
.slide.active .upcoming-card:nth-child(1){animation:aFadeUp .5s ease .5s both}
.slide.active .upcoming-card:nth-child(2){animation:aFadeUp .5s ease .7s both}
.slide.active .upcoming-card:nth-child(3){animation:aFadeUp .5s ease .9s both}

/* KPI Targets */
.slide.active .kpi-layout{animation:aFadeIn .3s ease .4s both}
.slide.active .kpi-card:nth-child(1){animation:aFadeUp .4s ease .5s both}
.slide.active .kpi-card:nth-child(2){animation:aFadeUp .4s ease .65s both}
.slide.active .kpi-card:nth-child(3){animation:aFadeUp .4s ease .8s both}
.slide.active .kpi-card:nth-child(4){animation:aFadeUp .4s ease .95s both}

/* IP grid */
.slide.active .ip-grid{animation:aFadeIn .3s ease .5s both}
.slide.active .ip-card:nth-child(1){animation:aFadeUp .4s ease .55s both}
.slide.active .ip-card:nth-child(2){animation:aFadeUp .4s ease .7s both}
.slide.active .ip-card:nth-child(3){animation:aFadeUp .4s ease .85s both}
.slide.active .ip-card:nth-child(4){animation:aFadeUp .4s ease 1.0s both}

/* MS Strategy */
.slide.active .ms-strategy{animation:aFadeIn .3s ease .5s both}
.slide.active .ms-phase:nth-child(1){animation:aFadeUp .5s ease .55s both}
.slide.active .ms-phase:nth-child(2){animation:aFadeUp .5s ease .75s both}
.slide.active .ms-phase:nth-child(3){animation:aFadeUp .5s ease .95s both}

/* Financial */
.slide.active .fin-layout{animation:aFadeUp .5s ease .5s both}
.slide.active .fin-card:nth-child(1){animation:aFadeUp .4s ease .55s both}
.slide.active .fin-card:nth-child(2){animation:aFadeUp .4s ease .7s both}
.slide.active .fin-card:nth-child(3){animation:aFadeUp .4s ease .85s both}
.slide.active .inv-timeline{animation:aFadeUp .5s ease 1.0s both}

/* B2B Grid */
.slide.active .b2b-grid{animation:aFadeIn .3s ease .5s both}
.slide.active .b2b-card:nth-child(1){animation:aFadeUp .4s ease .55s both}
.slide.active .b2b-card:nth-child(2){animation:aFadeUp .4s ease .7s both}
.slide.active .b2b-card:nth-child(3){animation:aFadeUp .4s ease .85s both}
.slide.active .b2b-card:nth-child(4){animation:aFadeUp .4s ease 1.0s both}

/* The Ask */
.slide.active .ask-stats{animation:aFadeUp .5s ease .55s both}
.slide.active .cta-buttons{animation:aFadeUp .45s ease .8s both}

/* Chart animation */
.mkt-line{stroke-dasharray:2000;stroke-dashoffset:2000}
.mkt-chart-area.animate .mkt-line{stroke-dashoffset:0;transition:stroke-dashoffset 3.9s cubic-bezier(.25,.1,.25,1)}
.mkt-chart-area.animate .mkt-line-vibe{transition-delay:0.6s;transition-duration:3.3s}
.mkt-chart-area.animate .mkt-clabel{opacity:1;transform:translateX(0)}
.mkt-chart-area.animate .mkt-clabel.green{transition-delay:1.5s}
.mkt-chart-area.animate .mkt-clabel.blue{transition-delay:1.6s}
.mkt-chart-area.animate .mkt-clabel.orange{transition-delay:1.7s}

/* ── LANG VISIBILITY ── */
[data-lang="en"]{display:none !important}
[data-lang="ko"]{display:revert}
[data-lang="ja"]{display:none !important}
body.en [data-lang="en"]{display:revert !important}
body.en [data-lang="ko"]{display:none !important}
body.en [data-lang="ja"]{display:none !important}
body.ja [data-lang="ja"]{display:revert !important}
body.ja [data-lang="ko"]{display:none !important}
body.ja [data-lang="en"]{display:none !important}
.ov-circle[data-lang="ko"]{display:flex !important}
.ov-circle[data-lang="en"]{display:none !important}
.ov-circle[data-lang="ja"]{display:none !important}
body.en .ov-circle[data-lang="en"]{display:flex !important}
body.en .ov-circle[data-lang="ko"]{display:none !important}
body.ja .ov-circle[data-lang="ja"]{display:flex !important}
body.ja .ov-circle[data-lang="ko"]{display:none !important}

/* Disable all animations when body.no-motion */
body.no-motion *,
body.no-motion *::before,
body.no-motion *::after{animation-duration:0.001s !important;animation-delay:0s !important;transition-duration:0.001s !important;transition-delay:0s !important}

body.no-motion .slide.active .slide-inner,
body.no-motion .slide.active .section-label,
body.no-motion .slide.active .section-title,
body.no-motion .slide.active .section-desc,
body.no-motion .slide.active .hero-left,
body.no-motion .slide.active .hero-right,
body.no-motion .slide.active .hero-stats,
body.no-motion .slide.active .problem-flow,
body.no-motion .slide.active .problem-col,
body.no-motion .slide.active .solution-step,
body.no-motion .slide.active .solution-content,
body.no-motion .slide.active .svc-phase,
body.no-motion .slide.active .svc-phases,
body.no-motion .slide.active .svc-cloud-bar,
body.no-motion .slide.active .team-layout,
body.no-motion .slide.active .gp-nda-row,
body.no-motion .slide.active .gp-countries,
body.no-motion .slide.active .roadmap-container,
body.no-motion .slide.active .roadmap-year,
body.no-motion .slide.active .exit-chart-area,
body.no-motion .slide.active .biz-diagram-wrap,
body.no-motion .slide.active .biz-rev-summary,
body.no-motion .slide.active .mkt-stage,
body.no-motion .slide.active .mkt-table-wrap,
body.no-motion .slide.active .mkt-chart-area,
body.no-motion .slide.active .comp-zaemit-cell,
body.no-motion .slide.active .svg-draw,
body.no-motion .slide.active .svg-area,
body.no-motion .slide.active .sales-layout,
body.no-motion .slide.active .upcoming-grid,
body.no-motion .slide.active .upcoming-card,
body.no-motion .slide.active .kpi-layout,
body.no-motion .slide.active .kpi-card,
body.no-motion .slide.active .ask-stats,
body.no-motion .slide.active .mkt-fc-stats,
body.no-motion .slide.active .mkt-fc-body,
body.no-motion .slide.active .mkt-src-wrap,
body.no-motion .slide.active .overview-layout,
body.no-motion .slide.active .ip-grid,
body.no-motion .slide.active .ip-card,
body.no-motion .slide.active .ms-strategy,
body.no-motion .slide.active .ms-phase,
body.no-motion .slide.active .fin-layout,
body.no-motion .slide.active .fin-card,
body.no-motion .slide.active .inv-timeline,
body.no-motion .slide.active .b2b-grid,
body.no-motion .slide.active .b2b-card,
body.no-motion .slide.active .pricing-grid,
body.no-motion .slide.active .pricing-card,
body.no-motion .slide.active .comp-table,
body.no-motion .slide.active .market-content,
body.no-motion .slide.active .mkt-stages,
body.no-motion .slide.active .mkt-maturity-label,
body.no-motion .slide.active .mkt-bullets{opacity:1 !important;transform:none !important}

body.no-motion .svg-draw,
body.no-motion .svg-draw-rev,
body.no-motion .svg-draw-sub,
body.no-motion .mkt-line{stroke-dashoffset:0 !important}
body.no-motion .mkt-clabel{opacity:1 !important;transform:translateX(0) !important}
body.no-motion .orbit-ring,
body.no-motion .particle,
body.no-motion .hero-badge::before{animation:none !important}
body.no-motion .particles{display:none !important}

/* ── HERO ── */
.hero{background:radial-gradient(ellipse at 20% 50%,rgba(0,102,255,0.15) 0%,transparent 60%),radial-gradient(ellipse at 80% 20%,rgba(124,58,237,0.1) 0%,transparent 50%),radial-gradient(ellipse at 50% 80%,rgba(0,212,170,0.08) 0%,transparent 50%),var(--dark)}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);background-size:4.6875vw 4.6875vw}
.hero .slide-inner{display:flex;align-items:center;gap:5vw}
.hero-left{flex:1}
.hero-badge{display:inline-flex;align-items:center;gap:0.625vw;padding:0.78125vw 1.875vw;border-radius:3.125vw;background:rgba(0,212,170,0.1);border:1px solid rgba(0,212,170,0.3);color:var(--accent);font-size:max(18px,1.09375vw);font-weight:600;text-transform:uppercase;letter-spacing:0.117vw;margin-bottom:2.1875vw}
.hero-badge::before{content:'';width:0.625vw;height:0.625vw;border-radius:50%;background:var(--accent);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.hero h1{font-family:'Plus Jakarta Sans';font-size:4.6875vw;font-weight:800;line-height:1.05;color:#fff;margin-bottom:1.5625vw;letter-spacing:-0.195vw;white-space:nowrap}
.gradient-text{background:var(--gradient1);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero-sub{font-size:1.5625vw;color:var(--text-muted);line-height:1.7;margin-bottom:3.125vw;max-width:48.4375vw}
.hero-stats{display:flex;gap:3vw}
.hero-stats>div{text-align:center;min-width:7.8125vw}
.hero-stat-value{font-family:'Plus Jakarta Sans';font-size:2.8125vw;font-weight:700;background:var(--gradient2);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero-stat-label{font-size:max(18px,1.015625vw);color:var(--text-muted);margin-top:0.46875vw;text-transform:uppercase;letter-spacing:0.078vw}
.hero-right{flex:.7;position:relative}
.hero-visual{width:100%;aspect-ratio:1;position:relative;background:radial-gradient(circle at center,rgba(0,102,255,0.2),transparent 70%);border-radius:50%}
.orbit-ring{position:absolute;border:1px solid rgba(255,255,255,0.06);border-radius:50%;animation:rot 20s linear infinite}
.orbit-ring:nth-child(1){inset:10%}.orbit-ring:nth-child(2){inset:25%;animation-duration:30s;animation-direction:reverse}.orbit-ring:nth-child(3){inset:40%;animation-duration:25s}
@keyframes rot{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.orbit-dot{position:absolute;width:0.9375vw;height:0.9375vw;border-radius:50%;background:var(--accent);box-shadow:0 0 1.5625vw var(--accent)}
.orbit-ring:nth-child(1) .orbit-dot{top:0;left:50%;transform:translate(-50%,-50%)}
.orbit-ring:nth-child(2) .orbit-dot{bottom:10%;right:0;background:var(--accent2);box-shadow:0 0 1.5625vw var(--accent2)}
.orbit-ring:nth-child(3) .orbit-dot{top:50%;left:0;transform:translate(-50%,-50%);background:var(--primary);box-shadow:0 0 1.5625vw var(--primary)}
.center-logo{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:8.59375vw;height:8.59375vw;border-radius:2.1875vw;background:var(--gradient1);display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans';font-size:2.65625vw;font-weight:800;color:#fff;box-shadow:0 1.5625vw 4.6875vw rgba(0,102,255,0.4)}
.particles{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.particle{position:absolute;width:0.3125vw;height:0.3125vw;border-radius:50%;background:rgba(0,212,170,0.3);animation:fl 8s ease-in-out infinite}
@keyframes fl{0%,100%{transform:translateY(0) translateX(0);opacity:0}10%{opacity:1}90%{opacity:1}50%{transform:translateY(-15.625vw) translateX(3.90625vw)}}

/* ── SECTION DIVIDER ── */
.section-divider{background:radial-gradient(ellipse at 50% 50%,rgba(0,102,255,0.12) 0%,transparent 65%),var(--dark)}
.section-divider .slide-inner{max-width:62.5vw}

/* ── SECTION HEADERS ── */
.section-label{display:inline-flex;align-items:center;gap:0.78125vw;font-size:max(18px,1.171875vw);font-weight:600;text-transform:uppercase;letter-spacing:0.195vw;color:var(--accent);margin-bottom:0.78125vw}
.section-label::before{content:'';width:2.1875vw;height:0.15625vw;background:var(--accent)}
.section-title{font-family:'Plus Jakarta Sans';font-size:2.8125vw;font-weight:700;color:#fff;line-height:1.12;margin-bottom:1.875vw;letter-spacing:-0.117vw}
.section-desc{font-size:1.40625vw;color:var(--text-muted);line-height:1.75;max-width:100%;margin-bottom:2.8125vw}

/* ── TOC ── */
.toc-slide{background:radial-gradient(ellipse at 50% 30%,rgba(0,102,255,0.08) 0%,transparent 60%),var(--dark)}
.toc-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25vw 2.5vw;margin-top:2vw}
.toc-item{display:flex;align-items:center;gap:1vw;padding:1.25vw 1.5vw;border-radius:0.75vw;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);transition:background .3s,border-color .3s}
.toc-item:hover{background:rgba(255,255,255,0.07);border-color:rgba(0,212,170,0.2)}
.toc-num{font-family:'Plus Jakarta Sans';font-size:max(18px,1.09vw);font-weight:800;color:var(--accent);min-width:2vw}
.toc-label{font-size:max(18px,1.25vw);font-weight:600;color:#fff}

/* TOC animations */
.slide .toc-grid,.slide .toc-item{opacity:0}
.slide.active .toc-grid{animation:aFadeIn .3s ease .45s both}
.slide.active .toc-item:nth-child(1){animation:aSlideR .4s ease .5s both}
.slide.active .toc-item:nth-child(2){animation:aSlideL .4s ease .55s both}
.slide.active .toc-item:nth-child(3){animation:aSlideR .4s ease .6s both}
.slide.active .toc-item:nth-child(4){animation:aSlideL .4s ease .65s both}
.slide.active .toc-item:nth-child(5){animation:aSlideR .4s ease .7s both}
.slide.active .toc-item:nth-child(6){animation:aSlideL .4s ease .75s both}
.slide.active .toc-item:nth-child(7){animation:aSlideR .4s ease .8s both}
.slide.active .toc-item:nth-child(8){animation:aSlideL .4s ease .85s both}
body.no-motion .slide.active .toc-grid,body.no-motion .slide.active .toc-item{opacity:1 !important;transform:none !important}

/* ── MARKET ── */
.market-content{margin-top:1.09375vw;display:flex;flex-direction:column;gap:0}
.mkt-bullets{display:flex;flex-direction:column;gap:0.46875vw;margin-bottom:1.25vw}
.mkt-bullet{font-size:max(18px,1.328125vw);color:var(--text);line-height:1.6;padding-left:1.71875vw;position:relative}
.mkt-bullet::before{content:'•';position:absolute;left:0;color:var(--accent);font-weight:700}
.mkt-bullet b{color:#fff}
.mkt-bullet .highlight{color:#EF4444;font-weight:700}
.mkt-bullet .blue{color:var(--primary);font-weight:700}
.mkt-timeline{position:relative;padding:1.875vw 0 0;overflow:hidden}
.mkt-chart-area{position:relative;height:15.625vw;border-bottom:0.15625vw solid rgba(255,255,255,0.15);margin-bottom:0}
.mkt-chart-area svg{position:absolute;inset:0;width:100%;height:100%}
.mkt-chart-labels{position:absolute;right:0.625vw;top:0;bottom:0;pointer-events:none;z-index:5}
.mkt-clabel{position:absolute;right:0;font-size:max(18px,1.171875vw);font-weight:700;padding:0.46875vw 1.25vw;border-radius:0.46875vw;white-space:nowrap;opacity:0;transform:translateX(0.78125vw);transition:opacity .4s ease,transform .4s ease;backdrop-filter:blur(8px);text-shadow:0 0.15625vw 0.46875vw rgba(0,0,0,0.8);border:1px solid rgba(255,255,255,0.12)}
.mkt-clabel.green{color:#22C55E;background:rgba(10,14,39,0.85);border-color:rgba(34,197,94,0.3)}
.mkt-clabel.blue{color:#3B82F6;background:rgba(10,14,39,0.85);border-color:rgba(59,130,246,0.3)}
.mkt-clabel.orange{color:#F97316;background:rgba(10,14,39,0.85);border-color:rgba(249,115,22,0.3)}
.mkt-years{display:grid;grid-template-columns:repeat(4,1fr);border-top:0.15625vw solid rgba(255,255,255,0.15)}
.mkt-year{text-align:center;padding-top:0.9375vw;position:relative}
.mkt-year::before{content:'';position:absolute;top:-0.46875vw;left:50%;width:0.78125vw;height:0.78125vw;border-radius:50%;background:var(--dark);border:0.15625vw solid rgba(255,255,255,0.3);transform:translateX(-50%)}
.mkt-year:last-child::before{background:var(--accent);border-color:var(--accent)}
.mkt-year-num{font-family:'Plus Jakarta Sans';font-size:1.5625vw;font-weight:700;color:#fff}
.mkt-year:last-child .mkt-year-num{color:var(--accent)}
.mkt-year-label{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-top:0.3125vw}
.mkt-year:last-child .mkt-year-label{color:var(--accent);font-weight:600}

/* Market stages */
.mkt-maturity-label{font-size:1.5625vw;font-weight:800;color:var(--primary);margin-bottom:0.46875vw}
.mkt-stages{display:flex;align-items:stretch;gap:0.46875vw;margin-bottom:0.625vw}
.mkt-stage{flex:1;padding:0.78125vw 0.78125vw;border-radius:0.9375vw;text-align:left;position:relative;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08)}
.mkt-stage:not(:last-child)::after{content:'▸';position:absolute;right:-0.9375vw;top:50%;transform:translateY(-50%);font-size:max(18px,1.25vw);color:rgba(255,255,255,0.2);z-index:1}
.mkt-stage:last-child{background:rgba(249,115,22,0.15);border:0.117vw solid rgba(249,115,22,0.4)}
.mkt-stage-num{font-family:'Plus Jakarta Sans';font-size:1.71875vw;font-weight:800;color:#fff;margin-bottom:0.15625vw}
.mkt-stage:last-child .mkt-stage-num{color:#F97316}
.mkt-stage-text{font-size:max(18px,1.015625vw);color:var(--text-muted);line-height:1.35;white-space:nowrap}
.mkt-stage:last-child .mkt-stage-text{color:rgba(249,115,22,0.85);font-weight:600}
.mkt-stage-current{background:linear-gradient(145deg,rgba(0,212,170,0.2),rgba(0,102,255,0.15));border:0.15625vw solid rgba(0,212,170,0.6);box-shadow:0 0 2.1875vw rgba(0,212,170,0.25)}
.mkt-stage-current .mkt-stage-num{font-size:2.34375vw;font-weight:900;background:linear-gradient(135deg,#00D4AA,#7DD3FC);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.mkt-stage-current .mkt-stage-text{color:#fff;font-weight:800;font-size:max(18px,1.015625vw);white-space:nowrap}
.mkt-stage-marker{margin-top:0.46875vw;font-size:max(18px,1.015625vw);font-weight:800;color:#FBBF24;letter-spacing:0.03125vw}

/* Market forecast stats */
.mkt-fc-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1.40625vw;margin-bottom:1.5625vw}
.mkt-fc-stat{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw;padding:1.5625vw 1.25vw;text-align:center}
.mkt-fc-stat-value{font-family:'Plus Jakarta Sans';font-size:2.34375vw;font-weight:800;line-height:1.1}
.mkt-fc-stat-value.cyan{color:var(--accent)}
.mkt-fc-stat-value.blue{color:var(--primary)}
.mkt-fc-stat-value.purple{color:var(--accent2)}
.mkt-fc-stat-label{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-top:0.46875vw}
.mkt-fc-body{display:flex;gap:1.875vw;align-items:stretch}
.mkt-fc-chart{flex:1.2;background:rgba(17,22,51,0.4);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw;padding:1.5625vw;display:flex;align-items:center;justify-content:center}
.mkt-fc-details{flex:1;display:flex;flex-direction:column;gap:0.9375vw}
.mkt-fc-detail{padding:1.09375vw 1.25vw;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:0.78125vw}
.mkt-fc-detail h4{font-size:max(18px,1.25vw);font-weight:700;color:#fff;margin-bottom:0.3125vw}
.mkt-fc-detail p{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.5}

/* ── PROBLEM ── */
.problem{background:radial-gradient(ellipse at 70% 50%,rgba(236,72,153,0.08) 0%,transparent 60%),var(--dark)}
.problem-flow{display:grid;grid-template-columns:repeat(3,1fr);gap:2.1875vw;margin-top:2.5vw}
.problem-col{display:flex;flex-direction:column;align-items:center;text-align:center;gap:0}
.problem-col .p-title{font-size:2.1875vw;font-weight:800;color:#fff;margin-bottom:0.46875vw;min-height:2.34375vw;display:flex;align-items:center;justify-content:center}
.problem-col .p-desc{font-size:max(18px,1.171875vw);color:var(--text-muted);line-height:1.65;margin-bottom:0.625vw;max-width:23.4375vw;min-height:4.6875vw;display:flex;align-items:center;justify-content:center}
.problem-col .p-arrow{font-size:1.5625vw;color:var(--text-muted);margin-bottom:0.46875vw}
.problem-col .p-box{width:100%;min-height:7.8125vw;padding:1.875vw 1.5625vw;border-radius:1.5625vw;background:linear-gradient(145deg,rgba(124,58,237,0.35),rgba(99,102,241,0.25));border:1px solid rgba(124,58,237,0.3);margin-bottom:0.625vw;box-shadow:0 0.625vw 2.5vw rgba(124,58,237,0.2);display:flex;align-items:center;justify-content:center}
.problem-col .p-box-text{font-size:1.875vw;font-weight:800;color:#fff;line-height:1.4;text-align:center}
.problem-col .p-need{font-size:1.40625vw;font-weight:700;line-height:1.45;min-height:3.125vw;display:flex;align-items:center;justify-content:center}
.problem-col .p-need.red{color:#EF4444}
.problem-col .p-need.orange{color:#F59E0B}
.problem-col .p-need.purple{color:var(--accent2)}

/* ── SOLUTION ── */
.solution{background:radial-gradient(ellipse at 30% 50%,rgba(0,102,255,0.1) 0%,transparent 60%),radial-gradient(ellipse at 70% 80%,rgba(0,212,170,0.08) 0%,transparent 50%),var(--dark)}
.solution-flow{display:flex;justify-content:center;gap:1.875vw;margin-top:2.5vw}
.solution-step{flex:0 1 25vw;text-align:center;padding:2.1875vw 1.5625vw;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:1.40625vw;transition:transform .4s,background .4s}
.solution-step:hover{transform:translateY(-6px);background:rgba(255,255,255,0.04)}
.step-number{font-family:'Plus Jakarta Sans';font-size:max(18px,1.25vw);font-weight:800;color:var(--accent);margin-bottom:0.9375vw;letter-spacing:0.15625vw}
.step-icon{margin-bottom:1.25vw}
.solution-step h3{font-size:1.875vw;font-weight:800;color:#fff;margin-bottom:0.78125vw}
.solution-step p{font-size:max(18px,1.25vw);color:var(--text-muted);line-height:1.65}

/* ── PRODUCT (SERVICE OVERVIEW) ── */
.product{background:radial-gradient(ellipse at 50% 30%,rgba(124,58,237,0.1) 0%,transparent 60%),var(--dark)}
.svc-phases{display:grid;grid-template-columns:repeat(3,1fr);gap:1.875vw;margin-top:2.5vw}
.svc-phase{background:rgba(17,22,51,0.8);border:1px solid rgba(255,255,255,0.08);border-radius:1.40625vw;padding:2.1875vw 1.875vw;display:flex;flex-direction:column;position:relative;overflow:hidden}
.svc-phase::before{content:'';position:absolute;top:0;left:0;right:0;height:0.3125vw;border-radius:1.40625vw 1.40625vw 0 0}
.svc-phase:nth-child(1)::before{background:var(--primary)}
.svc-phase:nth-child(2)::before{background:var(--accent)}
.svc-phase:nth-child(3)::before{background:var(--accent2)}
.svc-phase-num{font-family:'Plus Jakarta Sans';font-size:max(18px,1.09375vw);font-weight:800;letter-spacing:0.117vw;text-transform:uppercase;margin-bottom:0.78125vw}
.svc-phase:nth-child(1) .svc-phase-num{color:var(--primary)}
.svc-phase:nth-child(2) .svc-phase-num{color:var(--accent)}
.svc-phase:nth-child(3) .svc-phase-num{color:var(--accent2)}
.svc-phase h3{font-size:1.875vw;font-weight:800;color:#fff;margin-bottom:0.625vw;line-height:1.3}
.svc-phase-sub{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-bottom:1.40625vw;line-height:1.5}
.svc-feature-list{list-style:none;display:flex;flex-direction:column;gap:0.78125vw;flex:1}
.svc-feature-list li{display:flex;align-items:flex-start;gap:0.78125vw;font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.5}
.svc-ficon{flex-shrink:0;width:2.1875vw;height:2.1875vw;border-radius:0.625vw;display:flex;align-items:center;justify-content:center}
.svc-phase:nth-child(1) .svc-ficon{background:rgba(0,102,255,0.15)}
.svc-phase:nth-child(2) .svc-ficon{background:rgba(0,212,170,0.15)}
.svc-phase:nth-child(3) .svc-ficon{background:rgba(124,58,237,0.15)}
.svc-phase-badge{display:inline-block;margin-top:auto;padding-top:1.09375vw}
.svc-phase-badge span{font-size:max(18px,1.09375vw);font-weight:600;padding:0.390625vw 0.9375vw;border-radius:3.125vw;letter-spacing:0.039vw}
.svc-phase:nth-child(1) .svc-phase-badge span{background:rgba(0,102,255,0.15);color:var(--primary)}
.svc-phase:nth-child(2) .svc-phase-badge span{background:rgba(0,212,170,0.12);color:var(--accent)}
.svc-phase:nth-child(3) .svc-phase-badge span{background:rgba(124,58,237,0.15);color:var(--accent2)}
.svc-cloud-bar{margin-top:1.5625vw;padding:1.09375vw 1.875vw;border-radius:0.9375vw;background:linear-gradient(135deg,rgba(0,102,255,0.08),rgba(0,212,170,0.06));border:1px solid rgba(255,255,255,0.06);text-align:center;display:flex;align-items:center;justify-content:center;gap:1.5625vw;flex-wrap:wrap}
.svc-cloud-bar span{font-size:max(18px,1.09375vw);font-weight:600;color:var(--text-muted)}
.svc-cloud-bar b{color:var(--accent);font-weight:700}

/* ── COMPETITIVE ── */
.comp-table{width:100%;border-collapse:separate;border-spacing:0;margin-top:2.1875vw;border-radius:1.40625vw;overflow:hidden;border:1px solid rgba(255,255,255,0.08)}
.comp-table th,.comp-table td{padding:1.09375vw 1.09375vw;text-align:center;vertical-align:middle;line-height:1.5}
.comp-table thead th{background:rgba(255,255,255,0.04);font-size:max(18px,1.09375vw);font-weight:700;color:var(--text-muted);border-bottom:0.15625vw solid rgba(255,255,255,0.1)}
.comp-table thead th.comp-zaemit{background:rgba(99,102,241,0.15);color:#fff;font-size:2.1875vw;font-weight:800;font-family:'Plus Jakarta Sans','Pretendard Variable',sans-serif}
.comp-table tbody td{font-size:max(18px,1.09375vw);color:var(--text-muted);border-bottom:1px solid rgba(255,255,255,0.05)}
.comp-table .comp-row-label{color:#fff;font-weight:600;font-size:max(18px,1.09375vw);text-align:center;white-space:nowrap;background:rgba(255,255,255,0.02)}
.comp-table .comp-zaemit-cell{color:#fff;font-weight:600;font-size:1.5625vw;line-height:1.5;background:rgba(99,102,241,0.06);border-left:1px solid rgba(99,102,241,0.15);border-right:1px solid rgba(99,102,241,0.15)}
.comp-table .comp-zaemit-cell b{color:var(--accent);font-weight:700}
.comp-table tbody tr:hover td{background:rgba(255,255,255,0.02)}
.comp-table tbody tr:hover .comp-zaemit-cell{background:rgba(99,102,241,0.1)}

/* ── UPCOMING SERVICES ── */
.upcoming-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5625vw;margin-top:2.1875vw}
.upcoming-card{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.25vw;padding:2.1875vw 1.875vw;display:flex;flex-direction:column;gap:0.78125vw}
.upcoming-card-header{display:flex;align-items:center;gap:0.9375vw;margin-bottom:0.625vw}
.upcoming-card-icon{width:3.125vw;height:3.125vw;border-radius:0.78125vw;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.upcoming-card h3{font-size:1.5625vw;font-weight:800;color:#fff}
.upcoming-card-sub{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.5}
.upcoming-progress{margin-top:auto;padding-top:0.78125vw}
.upcoming-progress-bar{height:0.46875vw;border-radius:0.234375vw;background:rgba(255,255,255,0.08);overflow:hidden}
.upcoming-progress-fill{height:100%;border-radius:0.234375vw}
.upcoming-progress-label{display:flex;justify-content:space-between;margin-top:0.390625vw;font-size:max(18px,1.09375vw);color:var(--text-muted)}

/* ── IP / TECHNOLOGY ── */
.ip-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25vw;margin-top:2.1875vw}
.ip-card{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw;padding:1.875vw 1.5625vw;text-align:center;display:flex;flex-direction:column;align-items:center;gap:0.625vw}
.ip-card-value{font-family:'Plus Jakarta Sans';font-size:2.8125vw;font-weight:800}
.ip-card-value.cyan{color:var(--accent)}
.ip-card-value.blue{color:var(--primary)}
.ip-card-value.purple{color:var(--accent2)}
.ip-card-value.pink{color:#EC4899}
.ip-card-label{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.4}
.ip-card-sub{font-size:max(18px,1.09375vw);color:rgba(255,255,255,0.3);line-height:1.3}

/* ── MS STRATEGY ── */
.ms-strategy{display:grid;grid-template-columns:repeat(3,1fr);gap:1.875vw;margin-top:2.5vw}
.ms-phase{background:rgba(17,22,51,0.8);border:1px solid rgba(255,255,255,0.08);border-radius:1.40625vw;padding:2.1875vw 1.875vw;position:relative;overflow:hidden}
.ms-phase::before{content:'';position:absolute;top:0;left:0;right:0;height:0.3125vw;border-radius:1.40625vw 1.40625vw 0 0}
.ms-phase:nth-child(1)::before{background:var(--primary)}
.ms-phase:nth-child(2)::before{background:var(--accent)}
.ms-phase:nth-child(3)::before{background:var(--accent2)}
.ms-phase-num{font-family:'Plus Jakarta Sans';font-size:max(18px,1.09375vw);font-weight:800;letter-spacing:0.117vw;text-transform:uppercase;margin-bottom:0.78125vw}
.ms-phase:nth-child(1) .ms-phase-num{color:var(--primary)}
.ms-phase:nth-child(2) .ms-phase-num{color:var(--accent)}
.ms-phase:nth-child(3) .ms-phase-num{color:var(--accent2)}
.ms-phase h3{font-size:1.875vw;font-weight:800;color:#fff;margin-bottom:0.625vw}
.ms-phase-list{list-style:none;display:flex;flex-direction:column;gap:0.625vw}
.ms-phase-list li{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.5;padding-left:1.09375vw;position:relative}
.ms-phase-list li::before{content:'';position:absolute;left:0;top:0.625vw;width:0.390625vw;height:0.390625vw;border-radius:50%;background:var(--text-muted)}

/* ── B2B CLIENTS ── */
/* B2B Summary Stats */
.b2b-summary{display:flex;gap:1.5625vw;margin-bottom:2.1875vw}
.b2b-stat{flex:1;text-align:center;padding:1.25vw 0;border-radius:0.9375vw;background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06)}
.b2b-stat-value{font-family:'Plus Jakarta Sans';font-size:2.34375vw;font-weight:800;margin-bottom:0.3125vw}
.b2b-stat-value.accent{color:var(--accent)}.b2b-stat-value.blue{color:var(--primary)}.b2b-stat-value.purple{color:var(--accent2)}
.b2b-stat-label{font-size:max(18px,1.09375vw);color:var(--text-muted)}
/* B2B Grid */
.b2b-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25vw}
.b2b-card{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw;overflow:hidden;display:flex;flex-direction:column}
.b2b-card .b2b-shot{position:relative;aspect-ratio:16/7;background:#0C1330;overflow:hidden}
.b2b-card .b2b-shot::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(10,14,39,0.7) 100%);pointer-events:none}
.b2b-card .b2b-shot img{width:100%;height:100%;display:block;object-fit:cover;object-position:center top}
.b2b-card-body{padding:1.09375vw 1.25vw;display:flex;flex-direction:column;gap:0.3125vw;flex:1}
.b2b-card h4{font-size:max(18px,1.25vw);font-weight:700;color:#fff}
.b2b-card p{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.45}
.b2b-card .b2b-url{font-family:'Plus Jakarta Sans';font-size:max(18px,0.9375vw);color:rgba(226,232,240,0.5);letter-spacing:0.02em}
.b2b-card .b2b-status{font-size:max(18px,0.9375vw);font-weight:600;padding:0.234375vw 0.78125vw;border-radius:0.390625vw;display:inline-block;width:fit-content;margin-top:auto}
.b2b-status.done{background:rgba(0,212,170,0.12);color:var(--accent)}
.b2b-status.ongoing{background:rgba(0,102,255,0.12);color:var(--primary)}
/* Featured Card */
.b2b-featured{grid-column:1/-1;display:flex;align-items:center;gap:2.5vw;background:rgba(17,22,51,0.7);border:1px solid rgba(0,102,255,0.2);border-radius:1.09375vw;padding:1.5625vw 2.1875vw}
.b2b-featured-icon{flex-shrink:0;width:5vw;height:5vw;border-radius:1.09375vw;background:rgba(0,102,255,0.12);display:flex;align-items:center;justify-content:center}
.b2b-featured-content{flex:1}
.b2b-featured h4{font-size:1.875vw;font-weight:700;color:#fff;margin-bottom:0.3125vw}
.b2b-featured p{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.5}
.b2b-featured-right{text-align:right;flex-shrink:0}
.b2b-featured-amount{font-family:'Plus Jakarta Sans';font-size:2.5vw;font-weight:800;color:var(--primary)}

/* ── SALES STATUS ── */
.sales-status{background:radial-gradient(ellipse at 60% 40%,rgba(0,212,170,0.08) 0%,transparent 60%),var(--dark)}
.sales-layout{display:grid;grid-template-columns:1fr 1fr;gap:2.1875vw;margin-top:2.5vw;align-items:start}
.sales-chart-wrap{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.25vw;padding:1.875vw}
.sales-chart-title{font-size:max(18px,1.25vw);font-weight:700;color:#fff;margin-bottom:1.25vw}
.sales-chart-title span{color:var(--accent);font-weight:400;font-size:max(18px,1.09375vw);margin-left:0.46875vw}
.sales-right{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.25vw;padding:1.25vw}
.sales-right-title{font-size:max(18px,1.25vw);font-weight:700;color:var(--accent);margin-bottom:1.09375vw;text-align:center}
.sales-tbl{width:100%;border-collapse:collapse}
.sales-tbl th{padding:0.625vw 0.46875vw;font-size:max(18px,0.9375vw);font-weight:700;color:var(--text-muted);text-align:center;border-bottom:0.15625vw solid rgba(255,255,255,0.1)}
.sales-tbl td{padding:0.78125vw 0.46875vw;font-size:max(18px,1.09375vw);color:var(--text-muted);text-align:center;border-bottom:1px solid rgba(255,255,255,0.04);vertical-align:middle}
.sales-tbl .s-label{color:#fff;font-weight:600;text-align:left;font-size:max(18px,1.09375vw)}
.sales-tbl .s-num{font-family:'Plus Jakarta Sans';font-weight:800;color:#fff;font-size:1.5625vw}
.sales-tbl .s-desc{font-size:max(18px,0.9375vw);color:var(--text-muted);text-align:left}
.sales-total{border-top:0.15625vw solid rgba(255,255,255,0.12)}
.sales-total .s-label{color:var(--accent)}
.sales-total .s-num{color:var(--accent)}
.sales-arr{font-family:'Plus Jakarta Sans';font-size:1.40625vw;font-weight:800;color:var(--accent);text-align:left}
.muv-svg{width:100%;height:auto}
.sales-legend{display:flex;align-items:center;gap:0.625vw;margin-top:0.78125vw;font-size:0.859375vw;color:var(--text-muted)}
.sales-legend i{width:0.9375vw;height:0.9375vw;border-radius:0.234375vw;background:var(--accent);display:inline-block}
.muv-table{width:100%;border-collapse:collapse;margin-top:1.25vw;font-size:0.9375vw}
.muv-table th{padding:0.625vw 0.78125vw;font-weight:700;color:var(--text-muted);text-align:center;border-bottom:1px solid rgba(255,255,255,0.1);font-size:0.859375vw}
.muv-table td{padding:0.625vw 0.78125vw;text-align:center;color:var(--text-muted);border-bottom:1px solid rgba(255,255,255,0.04)}
.muv-table .muv-label{color:#fff;font-weight:600;text-align:left}
.muv-up{color:#00D4AA;font-weight:600}.muv-down{color:#EF4444;font-weight:600}
.plugin-store .section-title{margin-bottom:1.09375vw}
.plugin-store .section-desc{margin-bottom:0.3125vw}

/* ── FINANCIAL ── */
.fin-layout{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25vw;margin-top:2.1875vw}
.fin-card{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw;padding:1.5625vw 1.25vw;text-align:center}
.fin-card-year{font-family:'Plus Jakarta Sans';font-size:1.875vw;font-weight:800;color:var(--primary);margin-bottom:0.3125vw}
.fin-card-revenue{font-family:'Plus Jakarta Sans';font-size:2.5vw;font-weight:800;color:#fff;margin-bottom:0.3125vw}
.fin-card-growth{font-size:max(18px,1.09375vw);font-weight:700;color:var(--accent)}
.fin-card-desc{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-top:0.46875vw;line-height:1.4}
.inv-timeline{margin-top:1.5625vw;padding:1.25vw 1.5625vw;background:rgba(0,102,255,0.06);border:1px solid rgba(0,102,255,0.15);border-radius:1.09375vw;display:flex;align-items:center;gap:2.5vw;justify-content:center;flex-wrap:wrap}
.inv-item{text-align:center}
.inv-item-round{font-size:max(18px,1.09375vw);font-weight:700;color:var(--primary);margin-bottom:0.15625vw}
.inv-item-val{font-family:'Plus Jakarta Sans';font-size:max(18px,1.25vw);font-weight:800;color:#fff}
.inv-item-date{font-size:max(18px,1.09375vw);color:var(--text-muted)}
.inv-arrow{font-size:1.5625vw;color:rgba(255,255,255,0.2)}

/* ── KPI TARGETS ── */
.kpi-layout{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25vw;margin-top:2.5vw}
.kpi-card{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.25vw;padding:2.1875vw 1.5625vw;text-align:center;display:flex;flex-direction:column;align-items:center;gap:0.78125vw}
.kpi-card-icon{width:3.90625vw;height:3.90625vw;border-radius:0.9375vw;display:flex;align-items:center;justify-content:center}
.kpi-card-value{font-family:'Plus Jakarta Sans';font-size:2.5vw;font-weight:800;color:#fff}
.kpi-card-label{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.4}

/* ── GLOBAL PARTNERS ── */
.global-partners{background:radial-gradient(ellipse at 50% 30%,rgba(124,58,237,0.1) 0%,transparent 60%),var(--dark)}
.global-partners .slide-inner{display:flex;flex-direction:column}
.gp-nda-row{display:flex;gap:0.9375vw;margin-bottom:0.78125vw}
.gp-nda{display:flex;flex-direction:column;align-items:flex-start;padding:0.9375vw 1.25vw;flex:1;gap:0.3125vw;background:rgba(124,58,237,0.08);border:1px solid rgba(124,58,237,0.25);border-radius:1.09375vw}
.gp-nda-header{display:flex;align-items:center;gap:0.78125vw;width:100%}
.gp-nda-icon{flex-shrink:0}
.gp-nda-body{flex:1}
.gp-nda-badge{display:inline-block;padding:0.15625vw 0.625vw;border-radius:0.390625vw;background:rgba(124,58,237,0.2);color:#A78BFA;font-size:max(18px,1.09375vw);font-weight:800;letter-spacing:0.078vw;margin-bottom:0.234375vw}
.gp-nda h3{font-size:max(18px,1.09375vw);font-weight:800;color:#fff;margin-bottom:0}
.gp-nda p{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.35}
.gp-countries{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25vw;margin-top:1.25vw}
.gp-country{background:rgba(17,22,51,0.6);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw;padding:1.25vw 1.5625vw}
.gp-country-name{font-size:max(18px,1.25vw);font-weight:800;color:#fff;margin-bottom:0.625vw}
.gp-country-list{list-style:none}
.gp-country-list li{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.6;padding-left:0.78125vw;position:relative}
.gp-country-list li::before{content:'-';position:absolute;left:0;color:var(--text-muted)}

/* ── ROADMAP ── */
.roadmap{background:linear-gradient(135deg,#0A0F1C 0%,#0d1424 50%,#0A0F1C 100%)}
.roadmap .slide-inner{padding-top:5.46875vw;padding-bottom:4.6875vw}
.roadmap .section-label{margin-bottom:0.78125vw}
.roadmap .section-title{margin-bottom:0;font-size:3.75vw}
.roadmap-container{position:relative;margin-top:4.6875vw;width:100%;overflow:visible}
.roadmap-graph{position:absolute;bottom:3.125vw;left:0;width:100%;height:0.234375vw;background:linear-gradient(90deg,rgba(0,212,170,0.15) 0%,rgba(0,212,170,0.5) 50%,rgba(124,58,237,0.7) 100%);border-radius:0.15625vw}
.roadmap-graph::before{content:'';position:absolute;right:-1.25vw;top:50%;transform:translateY(-50%);border:0.46875vw solid transparent;border-left:0.78125vw solid #7C3AED}
.roadmap-timeline{position:relative;display:flex;justify-content:space-between;align-items:flex-end;gap:2.1875vw;width:100%;padding-bottom:4.6875vw}
.roadmap-year{flex:1;display:flex;flex-direction:column;transition:all .4s}
.roadmap-year:nth-child(1){padding-bottom:0}
.roadmap-year:nth-child(2){padding-bottom:5.46875vw}
.roadmap-year:nth-child(3){padding-bottom:10.9375vw}
.roadmap-year:nth-child(4){padding-bottom:16.40625vw}
.roadmap-year-label{font-family:'Plus Jakarta Sans';font-size:2.34375vw;font-weight:800;color:#00D4AA;margin-bottom:1.09375vw;line-height:1;display:flex;align-items:center;gap:0.9375vw}
.roadmap-year:nth-child(4) .roadmap-year-label{font-size:2.8125vw;color:#A78BFA}
.roadmap-year-label::before{content:'';width:1.09375vw;height:1.09375vw;background:#00D4AA;border-radius:50%;box-shadow:0 0 1.171875vw rgba(0,212,170,0.6)}
.roadmap-year:nth-child(4) .roadmap-year-label::before{width:1.40625vw;height:1.40625vw;background:#7C3AED;box-shadow:0 0 1.953125vw rgba(124,58,237,0.8)}
.roadmap-items{display:flex;flex-direction:column;gap:0.625vw}
.roadmap-item{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.55;padding:0.390625vw 0}
.roadmap-item b{color:#fff;font-weight:600}
.roadmap-item .rm-highlight{color:#00D4AA;font-weight:600}
.roadmap-item.highlight{background:linear-gradient(90deg,rgba(124,58,237,0.25) 0%,rgba(124,58,237,0.1) 100%);padding:0.78125vw 1.09375vw;border-radius:0.625vw;color:#fff;font-weight:600;font-size:max(18px,1.09375vw);margin-top:0.46875vw;border:1px solid rgba(124,58,237,0.4)}
.roadmap-item.highlight b{color:#A78BFA}
body.no-motion .roadmap-line{stroke-dashoffset:0 !important}

/* ── EXIT STRATEGY ── */
.exit-strategy{background:radial-gradient(ellipse at 30% 70%,rgba(0,212,170,0.08) 0%,transparent 60%),var(--dark)}
.exit-chart-area{position:relative;margin-top:1.5625vw;width:100%}
.exit-svg{width:100%;height:auto;overflow:hidden}

/* ── TEAM ── */
.team{background:radial-gradient(ellipse at 50% 50%,rgba(0,102,255,0.06) 0%,transparent 60%),var(--dark)}
.team-layout{display:grid;grid-template-columns:1fr 2fr;gap:2.8125vw;margin-top:2.1875vw;align-items:start}
.team-ceo{text-align:center}
.team-ceo .team-photo{width:10.9375vw;height:10.9375vw;margin:0 auto 1.09375vw}
.team-ceo h4{font-size:1.71875vw;font-weight:700;color:#fff;margin-bottom:0.15625vw}
.team-ceo .team-title{font-size:max(18px,1.09375vw);font-weight:700;color:var(--primary);margin-bottom:0.78125vw}
.team-ceo .team-bio{text-align:left;max-width:34.375vw;margin:0 auto}
.team-photo{width:7.03125vw;height:7.03125vw;border-radius:50%;overflow:hidden;flex-shrink:0;border:0.15625vw solid rgba(255,255,255,0.1)}
.team-photo img{width:100%;height:100%;object-fit:cover}
.team-role-tag{font-size:max(18px,1.09375vw);font-weight:600;color:var(--text-muted);margin-bottom:0.15625vw}
.team-members{display:grid;grid-template-columns:1fr 1fr;gap:1.5625vw}
.team-member{display:flex;gap:1.25vw;align-items:flex-start;padding:1.25vw;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:1.09375vw}
.team-member .team-photo{width:6.40625vw;height:6.40625vw}
.team-info{flex:1;min-width:0}
.team-info h4{font-size:max(18px,1.09375vw);font-weight:700;color:#fff;margin-bottom:0.3125vw}
.team-bio{list-style:none;padding:0;margin:0}
.team-bio li{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.6;padding-left:0.9375vw;position:relative}
.team-bio li::before{content:'-';position:absolute;left:0;color:var(--text-muted)}

/* ── ASK ── */
.ask{background:radial-gradient(ellipse at 50% 50%,rgba(0,102,255,0.15) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(124,58,237,0.1) 0%,transparent 50%),var(--dark);text-align:center}
.ask h2{font-family:'Plus Jakarta Sans';font-size:4.53125vw;font-weight:800;color:#fff;line-height:1.12;margin-bottom:1.875vw;letter-spacing:-0.15625vw}
.ask p.ask-desc{font-size:1.640625vw;color:var(--text-muted);margin-bottom:3.75vw;line-height:1.7}
.ask-stats{display:flex;justify-content:center;gap:5vw;margin-bottom:3.75vw}
.ask-stat{text-align:center}
.ask-stat-value{font-family:'Plus Jakarta Sans';font-size:3.75vw;font-weight:700;background:var(--gradient2);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.ask-stat-label{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-top:0.46875vw}
.cta-buttons{display:flex;justify-content:center;gap:1.5625vw}
.btn-primary{padding:1.25vw 3.28125vw;border-radius:3.125vw;border:none;cursor:pointer;background:var(--gradient2);color:#fff;font-size:max(18px,1.40625vw);font-weight:700;transition:transform .3s,box-shadow .3s}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 0.9375vw 3.125vw rgba(0,102,255,0.4)}
.btn-secondary{padding:1.25vw 3.28125vw;border-radius:3.125vw;cursor:pointer;background:transparent;color:#fff;font-size:max(18px,1.40625vw);font-weight:600;border:1px solid rgba(255,255,255,0.2);transition:all .3s}
.btn-secondary:hover{background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.4)}
.ask-footer{margin-top:2.8125vw;font-size:max(18px,1.09375vw);color:var(--text-muted)}

/* ── DEMO VIDEO ── */
.demo-video{background:var(--dark)}
.demo-video .slide-inner{display:flex;flex-direction:column;align-items:center}
.demo-video-wrap{width:100%;max-width:75vw;aspect-ratio:16/9;border-radius:1.25vw;overflow:hidden;margin-top:1.5625vw;border:1px solid rgba(255,255,255,0.08);background:#000}
.demo-video-wrap video{width:100%;height:100%;object-fit:cover}

/* ── PRICING PLAN ── */
.pricing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25vw;margin-top:2.5vw}
.pricing-card{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:1.25vw;padding:2.1875vw 1.5625vw;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;transition:border-color .3s,box-shadow .3s}
.pricing-card.featured{border-color:rgba(0,212,170,0.4);box-shadow:0 0 1.875vw rgba(0,212,170,0.12)}
.pricing-card-name{font-size:max(18px,1.40625vw);font-weight:800;color:#fff;margin-bottom:0.3125vw}
.pricing-card-sub{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-bottom:1.40625vw;line-height:1.4}
.pricing-price{font-family:'Plus Jakarta Sans';font-size:2.5vw;font-weight:800;margin-bottom:0.3125vw}
.pricing-card:nth-child(1) .pricing-price{color:var(--text)}
.pricing-card:nth-child(2) .pricing-price{color:#3B82F6}
.pricing-card:nth-child(3) .pricing-price{color:var(--accent)}
.pricing-card:nth-child(4) .pricing-price{background:var(--gradient3);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.pricing-period{font-size:max(18px,1.09375vw);color:var(--text-muted);margin-bottom:1.5625vw}
.pricing-features{list-style:none;width:100%;text-align:left;display:flex;flex-direction:column;gap:0.625vw}
.pricing-features li{font-size:max(18px,1.09375vw);color:var(--text-muted);line-height:1.45;padding:0.46875vw 0;border-bottom:1px solid rgba(255,255,255,0.04);display:flex;align-items:baseline;gap:0.625vw}
.pricing-features li::before{content:'';width:0.46875vw;height:0.46875vw;border-radius:50%;flex-shrink:0}
.pricing-card:nth-child(1) .pricing-features li::before{background:var(--text-muted)}
.pricing-card:nth-child(2) .pricing-features li::before{background:#3B82F6}
.pricing-card:nth-child(3) .pricing-features li::before{background:var(--accent)}
.pricing-card:nth-child(4) .pricing-features li::before{background:#7C3AED}
.pricing-features li b{color:#fff;font-weight:600}
.pricing-badge{position:absolute;top:-0.859375vw;left:50%;transform:translateX(-50%);padding:0.3125vw 1.09375vw;border-radius:1.5625vw;font-size:max(18px,1.09375vw);font-weight:700;letter-spacing:0.039vw;white-space:nowrap}
.pricing-badge.pop{background:var(--accent);color:var(--dark)}
.pricing-badge.ent{background:var(--gradient3);color:#fff}
</style>
</head>
<body>

<!-- ===== SLIDES ===== -->

<!-- 01 COVER / HERO -->
<div class="slide hero active" data-title-ko="WEVEN IR" data-title-en="WEVEN IR" data-title-ja="WEVEN IR">
  <div class="hero-grid"></div>
  <div class="slide-inner">
    <div class="hero-left">
