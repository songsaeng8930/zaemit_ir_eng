    </div>
    <div class="ask-footer" data-lang="ko">ceo@zaemit.com · zaemit.com · studio.zaemit.com</div>
    <div class="ask-footer" data-lang="en">ceo@zaemit.com · zaemit.com · studio.zaemit.com</div>
    <div class="ask-footer" data-lang="ja">ceo@zaemit.com · zaemit.com · studio.zaemit.com</div>
  </div>
</div>

<!-- ===== SCRIPT ===== -->
<script>
var slides = document.querySelectorAll('.slide');
var total = slides.length;
var current = 0;
var lang = 'ko';

// ── AUTO-ZOOM: fit slide-inner within safe area ──
function fitSlideContent(slide) {
  var inner = slide.querySelector('.slide-inner');
  if (!inner) return;
  inner.style.zoom = '';
  inner.style.overflow = 'visible';
  inner.style.maxHeight = 'none';
  void inner.offsetHeight;

  var naturalH = inner.scrollHeight;
  var naturalW = inner.scrollWidth;
  var vw = document.documentElement.clientWidth / 100;

  var cs = getComputedStyle(slide);
  var padTop = parseFloat(cs.paddingTop) || 0;
  var padBottom = parseFloat(cs.paddingBottom) || 0;
  var bottomReserve = Math.max(padBottom, 7 * vw);
  var availH = slide.clientHeight - padTop - bottomReserve;

  var padLeft = parseFloat(cs.paddingLeft) || 0;
  var padRight = parseFloat(cs.paddingRight) || 0;
  var availW = slide.clientWidth - padLeft - padRight;

  if ((naturalH > availH || naturalW > availW) && naturalH > 0 && naturalW > 0) {
    var z = Math.min(availH / naturalH, availW / naturalW);
    inner.style.zoom = Math.max(0.5, Math.min(1, z)).toFixed(4);
  }
  inner.style.overflow = '';
  inner.style.maxHeight = '';
}

function fitAllSlides() {
  var hidden = [];
  slides.forEach(function(s) {
    if (!s.classList.contains('active')) {
      s.style.display = 'flex';
      s.style.visibility = 'hidden';
      hidden.push(s);
    }
  });
  void document.body.offsetHeight;
  slides.forEach(function(s) { fitSlideContent(s); });
  hidden.forEach(function(s) { s.style.display = ''; s.style.visibility = ''; });
}

if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(function() { requestAnimationFrame(fitAllSlides); });
}
window.addEventListener('load', function() { requestAnimationFrame(fitAllSlides); });
window.addEventListener('resize', fitAllSlides);

function goTo(idx, source) {
  if (idx === current || idx < 0 || idx >= total) return;
  slides[current].classList.remove('active');
  current = idx;
  var next = slides[current];
  next.style.display = 'flex';
  next.style.visibility = 'hidden';
  fitSlideContent(next);
  next.style.display = '';
  next.style.visibility = '';
  next.classList.remove('active');
  void next.offsetHeight;
  next.classList.add('active');
  // Trigger chart drawing animation
  var chartArea = next.querySelector('.mkt-chart-area');
  if (chartArea) {
    chartArea.classList.remove('animate');
    void chartArea.offsetHeight;
    chartArea.classList.add('animate');
  }
  // Handle videos
  handleSlideVideos();
  // Update slide info
  if (window.irSlideInfo) window.irSlideInfo.current = current;
  if (window.parent !== window) {
    try { window.parent.postMessage({ type: 'slideChange', current: current, total: total }, '*'); } catch (e) {}
  }
}

// Video handling
function handleSlideVideos() {
  slides.forEach(function(s, i) {
    var videos = s.querySelectorAll('video');
    videos.forEach(function(v) {
      if (i === current) {
        v.currentTime = 0;
        v.play().catch(function() {});
      } else {
        v.pause();
        v.currentTime = 0;
      }
    });
  });
}

// Language switch
function setLang(l) {
  lang = l;
  document.body.classList.remove('en', 'ja');
  if (l === 'en') document.body.classList.add('en');
  if (l === 'ja') document.body.classList.add('ja');
  document.querySelectorAll('[data-lang]').forEach(function(el) {
    el.style.display = '';
  });
  requestAnimationFrame(fitAllSlides);
}
window.setLang = setLang;

// Keyboard
document.addEventListener('keydown', function(e) {
  switch(e.key) {
    case 'ArrowDown': case 'ArrowRight': case 'PageDown': case ' ':
      e.preventDefault(); goTo(current + 1, 'keyboard'); break;
    case 'ArrowUp': case 'ArrowLeft': case 'PageUp':
      e.preventDefault(); goTo(current - 1, 'keyboard'); break;
    case 'Home': e.preventDefault(); goTo(0, 'keyboard'); break;
    case 'End': e.preventDefault(); goTo(total - 1, 'keyboard'); break;
  }
});

// Mouse wheel
var wheelAcc = 0, wheelTimer = null, wheelLocked = false;
document.addEventListener('wheel', function(e) {
  e.preventDefault();
  if (wheelLocked) return;
  wheelAcc += e.deltaY;
  clearTimeout(wheelTimer);
  wheelTimer = setTimeout(function() { wheelAcc = 0; }, 150);
  if (Math.abs(wheelAcc) >= 80) {
    goTo(wheelAcc > 0 ? current + 1 : current - 1, 'wheel');
    wheelAcc = 0;
    wheelLocked = true;
    setTimeout(function() { wheelLocked = false; }, 400);
  }
}, { passive: false });

// Touch
var touchStartX = 0, touchStartY = 0, touchStartTime = 0, touchStartEl = null, hasMoved = false;
document.addEventListener('touchstart', function(e) {
  touchStartX = e.touches[0].clientX;
  touchStartY = e.touches[0].clientY;
  touchStartTime = Date.now();
  touchStartEl = e.target;
  hasMoved = false;
}, { passive: true });
document.addEventListener('touchmove', function(e) {
  var dx = Math.abs(e.touches[0].clientX - touchStartX);
  var dy = Math.abs(e.touches[0].clientY - touchStartY);
  if (dx > 10 || dy > 10) hasMoved = true;
}, { passive: true });
document.addEventListener('touchend', function(e) {
  if (hasMoved) return;
  if (touchStartEl && touchStartEl.closest('button, a, input')) return;
  var dt = Date.now() - touchStartTime;
  if (dt > 300) return;
  var screenWidth = window.innerWidth;
  if (touchStartX < 60) goTo(current - 1, 'touch');
  else if (touchStartX > screenWidth - 60) goTo(current + 1, 'touch');
});

// Expose for parent viewer
window.irSlideInfo = {
  slides: Array.from(slides).map(function(slide, i) {
    return {
      index: i,
      titleKo: slide.dataset.titleKo || '\uc2ac\ub77c\uc774\ub4dc ' + (i + 1),
      titleEn: slide.dataset.titleEn || 'Slide ' + (i + 1),
      titleJa: slide.dataset.titleJa || '\u30b9\u30e9\u30a4\u30c9 ' + (i + 1)
    };
  }),
  total: total,
  get current() { return current; }
};
window.goToSlide = function(idx) { goTo(idx, 'parent-viewer'); };
</script>
</body>
</html>
